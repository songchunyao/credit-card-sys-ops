# ============================================================================
# scheme2-onto/rules/r04.rq —— 方案2 原生 SPARQL CONSTRUCT 规则
# ----------------------------------------------------------------------------
#   规则执行口径: 见本文件头 + docs/04-appendix-ORSD.md「规则口径」一节
#   契约: shared/model/fault-modes.yaml#FM-CTR-OOM-KILLED
#   detect(all_of): container.oom_kill_total  predicate=increased
#   产出: F-004；关键否定性证据（docs/04 §6）: 双路径区分
#     host.mem_available_ratio（阈值 threshold:mem_available_ratio_severe#critical，E9 路径）
#     与 container.mem_working_set_mb > entity_property:Container.memLimitMb（E12 路径）二选一
#   ★ 口径: 双路径写成 ccp:findingDiscriminator 字符串，不从规则里删掉任一条。
#   ★ 组语义 v1.0.3（X-5）：本模式 detect 只有 all_of 一组，无并列组（组间 AND 退化为该组）。
#   ★ 口径 v1.0.3（X-7）：同 r03 —— increased 落在 cc:delta，三值（A 基线 / B 等效推导 /
#     U 不可判只登记不产 Finding）；旧「累计计数非零」降级路径已删除。
PREFIX cc:    <https://credit-card-ops.ai/onto/topology#>
PREFIX cco:   <https://credit-card-ops.ai/onto/core#>
PREFIX ccm:   <https://credit-card-ops.ai/onto/metric#>
PREFIX ccf:   <https://credit-card-ops.ai/onto/fault#>
PREFIX ccc:   <https://credit-card-ops.ai/onto/causal#>
PREFIX cca:   <https://credit-card-ops.ai/onto/action#>
PREFIX ccp:   <https://credit-card-ops.ai/onto/prov#>
PREFIX prov:  <http://www.w3.org/ns/prov#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
  ?finding a ccf:Finding ;
      ccf:findingCode "F-004" ;
      ccp:findingSeverity ?sev ;
      ccp:findingFaultMode ?fm ;
      ccp:findingFor ?target ;
      ccp:associatedRule ccp:Rule-r04 ;
      ccp:findingDiscriminator ?oomPath ;
      prov:wasDerivedFrom ?ev .
  # ★ v1.0.3（X-7）不可判登记：?uj 只在不可判分支绑定 ⇒ 成立分支不生成这几条三元组；
  #    反之 ?finding 只在成立分支绑定 ⇒ 不可判分支不产 Finding（既不成立也不证伪）。
  ?uj a cco:InformationEntity ;
      ccp:unjudgeableJudgment ccf:J-oom-1 ;
      ccp:unjudgeableFor ?target ;
      ccp:unjudgeableRule ccp:Rule-r04 ;
      ccp:unjudgeableReason ?ujReason ;
      prov:wasDerivedFrom ?ev .
}
WHERE {
  {
    BIND(ccf:FM-CTR-OOM-KILLED AS ?fm)  BIND("critical" AS ?sev)
    # --- A) 基线路径（v1.0.3 X-7）：cc:delta 存在且为正 ---
    ?target ccm:oomKillTotal ?now .
    ?target cc:hasEvidence ?ev .
    ?ev cc:metricCode "container.oom_kill_total"^^xsd:string ;
        cc:delta ?delta ; cc:deltaWindowS ?window .
    ?zeroBase ccm:tierReference "baseline:counter_non_zero" ;
              ccm:baselineValue ?zero .
    FILTER(xsd:decimal(?delta) > ?zero)
    FILTER NOT EXISTS { ?ev cc:counterReset true }
    BIND(IRI(CONCAT("https://credit-card-ops.ai/onto/inst/finding/",
                    "F-004/",
                    ENCODE_FOR_URI(STRAFTER(STR(?target), "/inst/")))) AS ?finding)
  }
  UNION
  {
    BIND(ccf:FM-CTR-OOM-KILLED AS ?fm)  BIND("critical" AS ?sev)
    # --- B) 等效推导路径：两条可比观测（capturedAt 更早 / rawValue 更小）推得 delta ---
    ?target ccm:oomKillTotal ?now .
    ?target cc:hasEvidence ?late , ?earlier .
    ?late    cc:metricCode "container.oom_kill_total"^^xsd:string ; cc:rawValue ?vLate    ; cc:capturedAt ?tLate .
    ?earlier cc:metricCode "container.oom_kill_total"^^xsd:string ; cc:rawValue ?vEarlier ; cc:capturedAt ?tEarlier .
    FILTER(str(?tEarlier) < str(?tLate))
    FILTER(xsd:decimal(?vEarlier) < xsd:decimal(?vLate))
    FILTER NOT EXISTS { ?late cc:counterReset true }
    FILTER NOT EXISTS { ?earlier cc:counterReset true }
    BIND(?late AS ?ev)
    BIND(IRI(CONCAT("https://credit-card-ops.ai/onto/inst/finding/",
                    "F-004/",
                    ENCODE_FOR_URI(STRAFTER(STR(?target), "/inst/")))) AS ?finding)
  }
  UNION
  {
    BIND(ccf:FM-CTR-OOM-KILLED AS ?fm)  BIND("critical" AS ?sev)
    # --- U) 不可判（X-7）：基线不可得 ⇒ 只登记 ccp:unjudgeable*，不产 Finding ---
    ?target ccm:oomKillTotal ?now .
    ?target cc:hasEvidence ?ev .
    ?ev cc:metricCode "container.oom_kill_total"^^xsd:string .
    FILTER NOT EXISTS {
      ?target cc:hasEvidence ?evB .
      ?evB cc:metricCode "container.oom_kill_total"^^xsd:string ; cc:delta ?dAny ; cc:deltaWindowS ?wAny .
      FILTER NOT EXISTS { ?evB cc:counterReset true }
    }
    FILTER NOT EXISTS {
      ?target cc:hasEvidence ?l2 , ?e2 .
      ?l2 cc:metricCode "container.oom_kill_total"^^xsd:string ; cc:capturedAt ?tl2 .
      ?e2 cc:metricCode "container.oom_kill_total"^^xsd:string ; cc:capturedAt ?te2 .
      FILTER(str(?te2) < str(?tl2))
    }
    BIND(IRI(CONCAT("https://credit-card-ops.ai/onto/inst/unjudgeable/",
                    "F-004/",
                    ENCODE_FOR_URI(STRAFTER(STR(?target), "/inst/")))) AS ?uj)
    BIND("基线不可用（cc:delta / cc:deltaWindowS 缺失，或 cc:counterReset=true）⇒ 该判据 unjudgeable：既不成立也不证伪；不产 Finding，按 WARN『待标定/不可机判』登记 zero-instance-ledger.yaml" AS ?ujReason)
  }
  UNION
  {
    # --- FM-HOST-DISK-FULL（P0.9 新增）---
    BIND(ccf:FM-HOST-DISK-FULL AS ?fm)  BIND("critical" AS ?sev)
    ?target a cc:Host ; ccm:fsMaxUsedPct ?v .
    ?tier a ccm:WarningThreshold ;
          ccm:tierReference "threshold:fs_usage_pct_light#warning" ;
          ccm:thresholdValue ?limit .
    FILTER(?v > ?limit)
    ?target cc:hasEvidence ?ev .
    ?ev cc:metricCode "host.fs_max_used_pct"^^xsd:string .
    BIND(IRI(CONCAT("https://credit-card-ops.ai/onto/inst/finding/",
                    "F-004/",
                    ENCODE_FOR_URI(STRAFTER(STR(?target), "/inst/")))) AS ?finding)
  }
  UNION
  {
    # --- FM-HOST-DISK-IO-ERROR（P0.9 新增）---
    BIND(ccf:FM-HOST-DISK-IO-ERROR AS ?fm)  BIND("critical" AS ?sev)
    ?target a cc:Host ; ccm:diskIoErrorsTotal ?v .
    ?nzBase ccm:tierReference "baseline:counter_non_zero" ;
            ccm:baselineValue ?zero .
    FILTER(?v > ?zero)
    ?target cc:hasEvidence ?ev .
    ?ev cc:metricCode "host.disk_io_errors_total"^^xsd:string .
    BIND(IRI(CONCAT("https://credit-card-ops.ai/onto/inst/finding/",
                    "F-004/",
                    ENCODE_FOR_URI(STRAFTER(STR(?target), "/inst/")))) AS ?finding)
  }

  # 双路径区分（E9 宿主内存 / E12 容器 limit）—— 对三个分支同样适用
  OPTIONAL {
      ?target cc:deployedOn ?host .
      ?host ccm:memAvailableRatio ?hostMem .
      ?hostTier ccm:tierReference "threshold:mem_available_ratio_severe#critical" ;
                ccm:thresholdValue ?hostMemLimit .
      FILTER(?hostMem < ?hostMemLimit)
  }
  OPTIONAL {
      ?target ccm:memWorkingSetMb ?workingSet ;
              cc:memLimitMb ?memLimit .
      FILTER(?workingSet > ?memLimit)
  }
  BIND(IF(BOUND(?hostMemLimit), "host-memory(E9)",
          IF(BOUND(?memLimit), "container-limit(E12)", "undetermined")) AS ?oomPath)
}
