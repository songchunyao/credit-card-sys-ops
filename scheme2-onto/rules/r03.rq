# ============================================================================
# scheme2-onto/rules/r03.rq —— 方案2 原生 SPARQL CONSTRUCT 规则
# ----------------------------------------------------------------------------
#   规则执行口径: 见本文件头 + docs/04-appendix-ORSD.md「规则口径」一节
#   契约: shared/model/fault-modes.yaml#FM-CTR-CPU-THROTTLED
#   detect(all_of): container.cpu_throttled_periods  predicate=increased
#   产出: F-003；关键否定性证据（docs/04 §6）: 「—（靠 Host 反证）」
#     ⇒ 本规则不做容器内否定式过滤；宿主侧因果在 ccc:CausalLink-E7（conditional_causes）
#        与 ccc:Discriminator-D1/D3 里表达，规则只判 detected。
#   ★ 组语义 v1.0.3（X-5）：本模式 detect 只有 all_of 一组 ⇒ 缺省 any_of 组中性成立，
#     组间 AND 即退化为该组本身；无并列组。
#   ★ 口径 v1.0.3（X-7）：predicate:increased 的判定落在 observation.delta（cc:delta），
#     三值实现 —— 成立（A/B）/ 不可判（U）；**已删除**旧「单快照累计计数非零」降级路径
#     （它把 non_zero 冒充 increased，是假阳性来源）：
#       A) 基线路径：cc:delta 存在且为正（比较基准取 TBox 零点常量 ccm:b_counter_non_zero，
#          规则内零数字字面量）+ cc:deltaWindowS 同现 + 该证据未被 cc:counterReset 标记；
#       B) 等效推导路径：同实体同指标两条**可比观测**（capturedAt 更早且 rawValue 更小）
#          ⇒ 由观测序列推得 delta（自定口径，见诚实清单）；
#       U) 不可判：A/B 都不成立且该指标有观测 ⇒ 只产 ccp:unjudgeable* 登记，不产 Finding。
PREFIX cc:    <https://credit-card-ops.ai/onto/topology#>
PREFIX cco:   <https://credit-card-ops.ai/onto/core#>
PREFIX ccm:   <https://credit-card-ops.ai/onto/metric#>
PREFIX ccf:   <https://credit-card-ops.ai/onto/fault#>
PREFIX ccc:   <https://credit-card-ops.ai/onto/causal#>
PREFIX cca:   <https://credit-card-ops.ai/onto/action#>
PREFIX ccp:   <https://credit-card-ops.ai/onto/prov#>
PREFIX prov:  <http://www.w3.org/ns/prov#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
  ?finding a ccf:Finding ;
      ccf:findingCode "F-003" ;
      ccp:findingSeverity "major" ;
      ccp:findingFaultMode ccf:FM-CTR-CPU-THROTTLED ;
      ccp:findingFor ?target ;
      ccp:associatedRule ccp:Rule-r03 ;
      prov:wasDerivedFrom ?ev .
  # ★ v1.0.3（X-7）不可判登记：?uj 只在不可判分支绑定 ⇒ 成立分支不生成这几条三元组；
  #    反之 ?finding 只在成立分支绑定 ⇒ 不可判分支不产 Finding（既不成立也不证伪）。
  ?uj a cco:InformationEntity ;
      ccp:unjudgeableJudgment ccf:J-throttle-1 ;
      ccp:unjudgeableFor ?target ;
      ccp:unjudgeableRule ccp:Rule-r03 ;
      ccp:unjudgeableReason ?ujReason ;
      prov:wasDerivedFrom ?ev .
}
WHERE {
  {
    # --- A) 基线路径（v1.0.3 X-7）：cc:delta 存在且为正 ---
    ?target ccm:cpuThrottledPeriods ?now .
    ?target cc:hasEvidence ?ev .
    ?ev cc:metricCode "container.cpu_throttled_periods"^^xsd:string ;
        cc:delta ?delta ; cc:deltaWindowS ?window .
    ?zeroBase ccm:tierReference "baseline:counter_non_zero" ;
              ccm:baselineValue ?zero .
    FILTER(xsd:decimal(?delta) > ?zero)
    FILTER NOT EXISTS { ?ev cc:counterReset true }
    BIND(IRI(CONCAT("https://credit-card-ops.ai/onto/inst/finding/",
                    "F-003/",
                    ENCODE_FOR_URI(STRAFTER(STR(?target), "/inst/")))) AS ?finding)
  }
  UNION
  {
    # --- B) 等效推导路径：两条可比观测（capturedAt 更早 / rawValue 更小）推得 delta ---
    ?target ccm:cpuThrottledPeriods ?now .
    ?target cc:hasEvidence ?late , ?earlier .
    ?late    cc:metricCode "container.cpu_throttled_periods"^^xsd:string ; cc:rawValue ?vLate    ; cc:capturedAt ?tLate .
    ?earlier cc:metricCode "container.cpu_throttled_periods"^^xsd:string ; cc:rawValue ?vEarlier ; cc:capturedAt ?tEarlier .
    FILTER(str(?tEarlier) < str(?tLate))
    FILTER(xsd:decimal(?vEarlier) < xsd:decimal(?vLate))
    FILTER NOT EXISTS { ?late cc:counterReset true }
    FILTER NOT EXISTS { ?earlier cc:counterReset true }
    BIND(?late AS ?ev)
    BIND(IRI(CONCAT("https://credit-card-ops.ai/onto/inst/finding/",
                    "F-003/",
                    ENCODE_FOR_URI(STRAFTER(STR(?target), "/inst/")))) AS ?finding)
  }
  UNION
  {
    # --- U) 不可判（X-7）：基线不可得 ⇒ 只登记 ccp:unjudgeable*，不产 Finding ---
    ?target ccm:cpuThrottledPeriods ?now .
    ?target cc:hasEvidence ?ev .
    ?ev cc:metricCode "container.cpu_throttled_periods"^^xsd:string .
    FILTER NOT EXISTS {
      ?target cc:hasEvidence ?evB .
      ?evB cc:metricCode "container.cpu_throttled_periods"^^xsd:string ; cc:delta ?dAny ; cc:deltaWindowS ?wAny .
      FILTER NOT EXISTS { ?evB cc:counterReset true }
    }
    FILTER NOT EXISTS {
      ?target cc:hasEvidence ?l2 , ?e2 .
      ?l2 cc:metricCode "container.cpu_throttled_periods"^^xsd:string ; cc:capturedAt ?tl2 .
      ?e2 cc:metricCode "container.cpu_throttled_periods"^^xsd:string ; cc:capturedAt ?te2 .
      FILTER(str(?te2) < str(?tl2))
    }
    BIND(IRI(CONCAT("https://credit-card-ops.ai/onto/inst/unjudgeable/",
                    "F-003/",
                    ENCODE_FOR_URI(STRAFTER(STR(?target), "/inst/")))) AS ?uj)
    BIND("基线不可用（cc:delta / cc:deltaWindowS 缺失，或 cc:counterReset=true）⇒ 该判据 unjudgeable：既不成立也不证伪；不产 Finding，按 WARN『待标定/不可机判』登记 zero-instance-ledger.yaml" AS ?ujReason)
  }
}
