# ===========================================================================
# 7) 叶子根因（F5 的排除法判据）—— ccf:RootCause，不计入 14
# ===========================================================================
ccf:FM-APP-AUTH-INCOMPATIBLE a ccf:RootCause ;
    ccf:rootCauseCode "FM-APP-AUTH-INCOMPATIBLE" ; cco:neutralCode "FM-APP-AUTH-INCOMPATIBLE" ;
    ccf:displayName "JDBC 驱动/认证方式不兼容" ;
    ccf:detectionMode "exclusion" ; ccf:chainCode "F5" ;
    ccf:rootCauseOf ccf:FM-APP-DS-CONNECT-FAIL ;
    ccf:rootCauseRequirement ccf:J-rcenc-1 , ccf:J-rcenc-2 , ccf:J-rcenc-3 , ccf:J-rcenc-4 ;
    ccf:note "★ 需要「否定性推理」：必须能断言『某个条件不成立』才能收敛到此根因" ;
    cco:contractSource "shared/model/causal-edges.yaml#/leaf_root_causes[subtype=FM-APP-AUTH-INCOMPATIBLE]" ;
    rdfs:label "JDBC 驱动/认证方式不兼容"@zh .

ccf:J-rcenc-1 a ccf:Judgment ; ccf:jRole "exclusion" ; ccf:jOperandKind "exclusion_clause" ;
    ccf:exclusionRequirementText "db.instance.up == true            （数据库在线）" ;
    ccf:jMetric ccm:m_db_instance_up ; ccf:jMetricCode "db.instance.up" ; ccf:jPredicate "is_true" ;
    ccf:jPredicateSemantics "observation.value 为 true" ; ccf:jBaselineRequired false ;
    cco:contractSource "causal-edges.yaml#/leaf_root_causes/exclusion_requirements[1]" .
ccf:J-rcenc-2 a ccf:Judgment ; ccf:jRole "exclusion" ; ccf:jOperandKind "exclusion_clause" ;
    ccf:exclusionRequirementText "host/container 网络可达             （网络正常）" ;
    ccf:jMetric ccm:m_app_datasource_connect_latency_ms ; ccf:jMetricCode "app.datasource.connect_latency_ms" ;
    ccf:jNote "网络不可达时 connect_latency_ms 会达到 connectionTimeoutMs；未达 ⇒ 网络正常" ;
    cco:contractSource "causal-edges.yaml#/leaf_root_causes/exclusion_requirements[2]" .
ccf:J-rcenc-3 a ccf:Judgment ; ccf:jRole "exclusion" ; ccf:jOperandKind "exclusion_clause" ;
    ccf:exclusionRequirementText "app.datasource.connect_latency_ms 立即失败而非超时（认证失败）" ;
    ccf:jMetric ccm:m_app_datasource_connect_latency_ms ; ccf:jMetricCode "app.datasource.connect_latency_ms" ;
    ccf:jNote "★ 与 F6 的区分器（causal-edges.yaml#discriminators[2]）" ;
    cco:contractSource "causal-edges.yaml#/leaf_root_causes/exclusion_requirements[3]" .
ccf:J-rcenc-4 a ccf:Judgment ; ccf:jRole "exclusion" ; ccf:jOperandKind "exclusion_clause" ;
    ccf:exclusionRequirementText "jdbcUrl / driverVersion / authMode 存在可疑变更（配置异常）" ;
    ccf:jNote "★ 契约里这几项**没有**对应的指标 code / 属性 ⇒ 本实现不伪造 IRI，仅保留原文（诚实清单第 1 条）" ;
    cco:contractSource "causal-edges.yaml#/leaf_root_causes/exclusion_requirements[4]" .

# ===========================================================================
# 8) 契约偏差登记
# ===========================================================================
# X-5  FM-APP-INSTANCE-RESTART / FM-CTR-NET-UNREACHABLE 的 detect 同级并列 any_of 与
#      all_of（FM-DB-INSTANCE-DOWN 只含 any_of）⇒ **v1.0.3 已裁定**：组内 AND/OR、
#      **组间 AND**、缺省组中性成立（依据 fault-modes.yaml#meta.detect_semantics）；
#      落成显式 ccf:groupOp（16 组）与 ccf:betweenGroupsOp "AND"（14 模式）公理。
# X-7  increased / decreased 需要窗口基线 ⇒ 基线缺失时判据 unjudgeable（不产 Finding、
#      按 WARN 登记台账、严禁当 false）。本体侧载体：ccf:jPredicateSemantics /
#      ccf:jBaselineRequired / ccf:unjudgeablePolicy（依据 fault-modes.yaml#meta.predicate_semantics）；
#      规则侧载体：scheme2-onto/rules/r03,r04,r06,r07.rq 的三值分支。
# 自定  ccf:fmComponentType / ccf:fmDetectionMode 的命名与值域（docs/04 未给规格）；
#      ccf:affectsSeverity 的命名（镜像方案1 CC_AFFECTS.severity，docs/04 未写）。
# 契约外指标  ccf:J-rcenc-4 的 4 条 exclusion_requirements 中第 4 条涉及
#      jdbcUrl/driverVersion/authMode，契约的 metrics.yaml 里**没有**这些指标 ⇒
#      不建属性、不建指标个体，只保留 requirement 原文。
# ===========================================================================
# 9) OWL 原生键公理（镜像 docs/03:67 的 Neo4j 唯一约束：
#    CREATE CONSTRAINT cc_uq_fm_code IF NOT EXISTS FOR (n:CC_FaultMode) REQUIRE n.fmCode IS UNIQUE）
#    ⇒ 同一诉求在 Neo4j 里是 DDL、不参与推理；在 OWL 2 里是**公理**（owl:hasKey）。
# ===========================================================================
ccf:FaultMode owl:hasKey ( ccf:faultModeCode ) .