# ============================================================================
# scheme2-onto/ontology/cc-fault.ttl  ·  方案2 故障域模块（ccf:）
# ----------------------------------------------------------------------------
# 职责（docs/04 §3 模块表）：23 个故障模式 + 判据公理（detect 的 all_of/any_of
#   结构 + distinguishing_evidence 否定性证据 + 叶子根因的排除法判据）。
# 命名空间（逐字取自 type-map.yaml#namespaces.onto）：ccf = .../onto/fault#
# 上游契约：shared/model/fault-modes.yaml（14 模式 + meta.predicate_enum）
#           —— 每条断言都带 cco:contractSource，逐条可追溯。
#
# ★ 故障域词表镜像（父代理追加规格；docs/03:187-211 已定方案1 侧词表）：
#   ccf:judgedBy  ←→ CC_JUDGED_BY   边属性 op / operandKind / operandValue / role
#   ccf:affects   ←→ CC_AFFECTS     边属性 severity
#   上述「边属性」在 RDF 里没有边，故**物化到 ccf:Judgment 个体**上：
#     ccf:jOp / ccf:jOperandKind / ccf:jOperandValue / ccf:jRole / ccf:affectsSeverity
#   ★ 诚实标注：docs/04 未给出 ccf:fmComponentType / ccf:fmDetectionMode 的规格
#     （§3 模块表与 §5 形状清单都没写这两个属性名）。本实现按与方案1 **同形的
#     lowerCamel** 取名，值域与判定口径见下（属自定，已进末条报告的诚实清单）：
#       ccf:fmComponentType  取值 = cc: 类 IRI（来自契约 component_type）
#       ccf:fmDetectionMode  取值 ∈ threshold | predicate | mixed | exclusion
#         （threshold=判据全部为「与数值参照比较」；predicate=全部为符号/状态谓词；
#          mixed=混合；exclusion=叶子根因的排除法）
#
# ★ 这些是**故障域原生关系**（来自契约 code），**不在** shared/mapping/rel-map.yaml
#   里 —— 不得把它们当作 ABox 投影关系；映射表未增补任何关系。
#
# ★ X-5（契约缺陷 → **v1.0.3 已裁定**；依据 shared/model/fault-modes.yaml#meta.detect_semantics）：
#   FM-APP-INSTANCE-RESTART / FM-CTR-NET-UNREACHABLE 的 detect 里 any_of 与 all_of
#   是**同级并列键**（另有 FM-DB-INSTANCE-DOWN 只含 any_of 组）。裁定后的语义：
#   **组内** all_of 全部成立、any_of 至少一条成立；**组间 AND**（all_of 组成立 ∧
#   any_of 组成立）；缺省组视为中性成立。★ 禁止组间 OR（会把 all_of 承载的
#   「必需条件」降级为可选，单条弱证据即可触发）。本模块把两个算子都落成
#   **显式公理**：每个组个体带 ccf:groupOp（all_of ⇒ AND、any_of ⇒ OR），
#   每个模式个体带 ccf:betweenGroupsOp "AND"，使分组语义可机检、不靠默认值。
#
# ★ X-7（v1.0.3 裁定）：符号谓词中的 increased / decreased **需要窗口基线**
#   （判定落在 observation.delta）：delta 缺失 ⇒ 该判据 **unjudgeable**（既不成立
#   也不证伪）；规则不得据此判故障成立，须按 WARN「待标定/不可机判」登记台账；
#   **严禁静默转为 false**。本模块给每条带 ccf:jPredicate 的判据补
#   ccf:jPredicateSemantics（逐字取自 fault-modes.yaml#meta.predicate_semantics），
#   increased / decreased 另加 ccf:jBaselineRequired true 与 ccf:unjudgeablePolicy
#   （契约原文）；规则体（rules\r03,r04,r06,r07.rq）实现「成立 / 不可判」三值分支。
#
# ★ 判定口径：ccf:FaultMode 的**个体**是 14 个（与契约集合相等，不多不少）；
#   F5 的叶子根因按契约 causal-edges.yaml#leaf_root_causes 落成 ccf:RootCause
#   个体（ccf:FM-APP-AUTH-INCOMPATIBLE），**不计入** 14 —— 因为它在契约里是
#   leaf_root_causes.subtype，而不是 fault_modes 条目。
#
# ★ OWL 原生 vs SHACL 补足（docs/04 §D6，分开计）：
#   OWL 原生（本模块）：rdfs:subClassOf / rdfs:domain / rdfs:range / owl:inverseOf /
#     owl:disjointWith / 个体的类型断言。**disjointness 用 OWL 原生表达**：
#     23 个故障模式声明为**互斥个体**（owl:AllDifferent）——这是方案1（LPG 无
#     互斥语义）无法表达、只能靠代码断言的公理（见报告「真正的强于」）。
#   SHACL 补足（ccs:，不在本模块）：severity 枚举、chain code 枚举、judgment 必须
#     有 metric 或 metricCode、anchor 成对（op 与 operandValue 同现）等 CWA 约束。
# ============================================================================
@prefix ccf:     <https://credit-card-ops.ai/onto/fault#> .
@prefix cc:      <https://credit-card-ops.ai/onto/topology#> .
@prefix ccm:     <https://credit-card-ops.ai/onto/metric#> .
@prefix cco:     <https://credit-card-ops.ai/onto/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

ccf: a owl:Ontology , dcat:Dataset ;
    dcterms:title "信用卡跨层运维本体 · 故障域模块（cc-fault）"@zh ;
    dcterms:description "14 故障模式 + 23 条判据 + 16 个判据组 + 1 条叶子根因（排除法）+ 否定性证据。"@zh ;
    cco:contractSource "shared/model/fault-modes.yaml + shared/model/causal-edges.yaml#/leaf_root_causes" ;
    skos:note "判据的 all_of/any_of 分组语义、否定性证据（distinguishing_evidence）与叶子根因的排除法判据都在本模块内以个体+公理表达，不用代码硬编码。"@zh .

# ===========================================================================
# 1) 类
# ===========================================================================
ccf:FaultMode a owl:Class ;
    rdfs:subClassOf cco:Occurrent ;
    rdfs:label "故障模式"@zh ;
    rdfs:comment "一次具体的故障发生（反刚性：同一对象可以此刻故障、彼时正常）。14 个个体与契约 fault_modes 一一对应。"@zh ;
    cco:rigidity "-R" ; cco:identity "-I" ; cco:unity "-U" ; cco:dependence "-D" ;
    cco:contractSource "fault-modes.yaml#/fault_modes" .

ccf:RootCause a owl:Class ;
    rdfs:subClassOf cco:Occurrent ;
    rdfs:label "根因（叶子）"@zh ;
    rdfs:comment "契约 leaf_root_causes 定义的**叶子歧义点**：多个链共享同一故障节点时，靠排除法（否定性证据）收敛到的根因。"@zh ;
    cco:rigidity "-R" ; cco:identity "-I" ; cco:unity "-U" ; cco:dependence "-D" ;
    cco:contractSource "causal-edges.yaml#/leaf_root_causes" .

ccf:Judgment a owl:Class ;
    rdfs:subClassOf cco:InformationEntity ;
    rdfs:label "判据"@zh ;
    rdfs:comment "一条判据 = 「某指标满足某条件」。镜像方案1 的 CC_JUDGED_BY 边属性（op/operandKind/operandValue/role）。"@zh ;
    cco:rigidity "+R" ; cco:identity "-I" ; cco:unity "+U" ; cco:dependence "-D" ;
    cco:contractSource "fault-modes.yaml#/fault_modes/detect + docs/03:187-211（方案1 词表镜像）" .

ccf:JudgmentGroup a owl:Class ;
    rdfs:subClassOf cco:InformationEntity ;
    rdfs:label "判据组"@zh ;
    rdfs:comment "all_of / any_of 分组（X-5，v1.0.3 裁定：组内 AND/OR、组间 AND、缺省组中性成立；两个算子分别物化为 ccf:groupOp 与 ccf:betweenGroupsOp）。"@zh ;
    cco:rigidity "+R" ; cco:identity "-I" ; cco:unity "+U" ; cco:dependence "-D" .

ccf:Finding a owl:Class ;
    rdfs:subClassOf cco:InformationEntity ;
    rdfs:label "诊断发现"@zh ;
    rdfs:comment "规则命中后产出的结论（cc-audit 模块把本类挂到 prov:Entity）。"@zh ;
    cco:rigidity "+R" ; cco:identity "-I" ; cco:unity "+U" ; cco:dependence "-D" .

# ===========================================================================
# 2) 对象属性（含 2 条 owl:inverseOf —— 方案1 的边属性无法表达的方向性）
# ===========================================================================
ccf:fmComponentType a owl:ObjectProperty ; rdfs:domain ccf:FaultMode ; rdfs:range owl:Class ;
    rdfs:label "故障组件类型"@zh ;
    rdfs:comment "来自契约 component_type；取值是 cc: 类 IRI。★ docs\\04 未给规格 ⇒ 按方案1 对称性取 lowerCamel。"@zh .
ccf:affects a owl:ObjectProperty ; rdfs:domain ccf:FaultMode ; rdfs:range owl:Class ;
    rdfs:label "影响（组件类型）"@zh ;
    rdfs:comment "镜像方案1 的 CC_AFFECTS（副作用属性 severity 物化为 ccf:affectsSeverity）。T3 校验其目标 == ccf:fmComponentType 的目标。"@zh .
ccf:judgedBy a owl:ObjectProperty ; rdfs:domain ccf:FaultMode ; rdfs:range ccf:Judgment ;
    owl:inverseOf ccf:judges ;
    rdfs:label "判定依据"@zh ;
    rdfs:comment "镜像方案1 的 CC_JUDGED_BY。T2 校验每条故障模式 ≥1 条本断言。"@zh .
ccf:judges a owl:ObjectProperty ; rdfs:domain ccf:Judgment ; rdfs:range ccf:FaultMode ;
    rdfs:label "判据所属故障模式"@zh .
ccf:hasJudgmentGroup a owl:ObjectProperty ; rdfs:domain ccf:FaultMode ; rdfs:range ccf:JudgmentGroup ;
    rdfs:label "判据组"@zh .
ccf:hasJudgment a owl:ObjectProperty ; rdfs:domain ccf:JudgmentGroup ; rdfs:range ccf:Judgment ;
    owl:inverseOf ccf:judgmentGroupOf ;
    rdfs:label "组内判据"@zh .
ccf:judgmentGroupOf a owl:ObjectProperty ; rdfs:domain ccf:Judgment ; rdfs:range ccf:JudgmentGroup ;
    rdfs:label "判据所属组"@zh .
ccf:hasDistinguishingEvidence a owl:ObjectProperty ; rdfs:domain ccf:FaultMode ; rdfs:range ccf:Judgment ;
    rdfs:label "否定性证据判据"@zh ;
    rdfs:comment "distinguishing_evidence：靠「某指标正常」定罪（契约里带 note 的排除项）。"@zh .
ccf:jMetric a owl:ObjectProperty ; rdfs:domain ccf:Judgment ; rdfs:range ccm:Metric ;
    rdfs:label "判据指标件"@zh ;
    rdfs:comment "指向 cc-metric 的指标个体 ⇒ 通过 ccm:metricProperty 既能找到数据属性、又能找到阈值档。契约 code 与本体 IRI 的双向可追溯。★ 方案1 只有字符串 code，没有这条可推理的链接。"@zh .
ccf:jThreshold a owl:ObjectProperty ; rdfs:domain ccf:Judgment ; rdfs:range ccm:Threshold ;
    rdfs:label "判据阈值档"@zh ;
    rdfs:comment "★ 引用式阈值（零硬编码）：比较的参照是本体里的档位个体，不是字面量。"@zh .
ccf:jOperandEntityProperty a owl:ObjectProperty ; rdfs:domain ccf:Judgment ; rdfs:range owl:DatatypeProperty ;
    rdfs:label "判据参照的实体属性"@zh ;
    rdfs:comment "operand 形如 entity_property:JdbcDataSource.maxPoolSize ⇒ 指向本体属性 IRI。"@zh .
ccf:rootCauseOf a owl:ObjectProperty ; rdfs:domain ccf:RootCause ; rdfs:range ccf:FaultMode ;
    owl:inverseOf ccf:hasRootCause ;
    rdfs:label "叶子根因所指故障模式"@zh .
ccf:hasRootCause a owl:ObjectProperty ; rdfs:domain ccf:FaultMode ; rdfs:range ccf:RootCause ;
    rdfs:label "故障模式的叶子根因"@zh .
ccf:rootCauseRequirement a owl:ObjectProperty ; rdfs:domain ccf:RootCause ; rdfs:range ccf:Judgment ;
    rdfs:label "排除法前提"@zh ;
    rdfs:comment "exclusion_requirements 逐条物化：全部成立于「其他候选被排除」时才收敛到本根因。"@zh .

# ===========================================================================
# 3) 数据属性
# ===========================================================================
ccf:faultModeCode a owl:DatatypeProperty ; rdfs:domain ccf:FaultMode ; rdfs:range xsd:string .
ccf:displayName a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ccf:FaultMode ccf:RootCause ) ] ; rdfs:range xsd:string .
ccf:faultLayer a owl:DatatypeProperty ; rdfs:domain ccf:FaultMode ; rdfs:range xsd:string ;
    rdfs:comment "App | Runtime | Data（契约 layer）。"@zh .
ccf:severity a owl:DatatypeProperty ; rdfs:domain ccf:FaultMode ; rdfs:range xsd:string ;
    rdfs:comment "契约 severity ∈ info | warning | major | critical。"@zh .
ccf:affectsSeverity a owl:DatatypeProperty ; rdfs:domain ccf:FaultMode ; rdfs:range xsd:string ;
    rdfs:comment "镜像方案1 CC_AFFECTS 的边属性 severity。"@zh .
ccf:reversible a owl:DatatypeProperty ; rdfs:domain ccf:FaultMode ; rdfs:range xsd:boolean .
ccf:chainCode a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ccf:FaultMode ccf:RootCause ) ] ; rdfs:range xsd:string ;
    rdfs:comment "契约 chain（F1..F7，可多个）。"@zh .
ccf:fmDetectionMode a owl:DatatypeProperty ; rdfs:domain ccf:FaultMode ; rdfs:range xsd:string ;
    rdfs:comment "★ docs\\04 未给规格 ⇒ 自定取值集 threshold | predicate | mixed | exclusion，判定口径见文件头。"@zh .
ccf:note a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ccf:FaultMode ccf:RootCause ) ] ; rdfs:range xsd:string .
ccf:groupKind a owl:DatatypeProperty ; rdfs:domain ccf:JudgmentGroup ; rdfs:range xsd:string ;
    rdfs:comment "all_of | any_of。"@zh .
ccf:groupOp a owl:DatatypeProperty ; rdfs:domain ccf:JudgmentGroup ; rdfs:range xsd:string ;
    rdfs:comment "★ v1.0.3（X-5）：**组内**合并算子，all_of ⇒ AND、any_of ⇒ OR（依据 fault-modes.yaml#meta.detect_semantics.within_all_of / within_any_of）。"@zh .
ccf:betweenGroupsOp a owl:DatatypeProperty ; rdfs:domain ccf:FaultMode ; rdfs:range xsd:string ;
    rdfs:comment "★ v1.0.3（X-5）：detect 并列组的**组间**合并算子，契约裁定恒为 AND（all_of 组成立 ∧ any_of 组成立；缺省组中性成立；禁止 OR）。依据 fault-modes.yaml#meta.detect_semantics.between_groups。"@zh .
ccf:jPredicateSemantics a owl:DatatypeProperty ; rdfs:domain ccf:Judgment ; rdfs:range xsd:string ;
    rdfs:comment "★ v1.0.3（X-7）：ccf:jPredicate 的判定口径，逐字取自 fault-modes.yaml#meta.predicate_semantics。"@zh .
ccf:jBaselineRequired a owl:DatatypeProperty ; rdfs:domain ccf:Judgment ; rdfs:range xsd:boolean ;
    rdfs:comment "★ v1.0.3（X-7）：该谓词是否必须带窗口基线（observation.delta）；契约 baseline_required 记为 [increased, decreased]，故只有这两类为 true。"@zh .
ccf:unjudgeablePolicy a owl:DatatypeProperty ; rdfs:domain ccf:Judgment ; rdfs:range xsd:string ;
    rdfs:comment "★ v1.0.3（X-7）：基线缺失时的处置，逐字取自 fault-modes.yaml#meta.predicate_semantics.unjudgeable_policy。"@zh .
ccf:jRole a owl:DatatypeProperty ; rdfs:domain ccf:Judgment ; rdfs:range xsd:string ;
    rdfs:comment "镜像方案1 CC_JUDGED_BY 的 role：detect | distinguishing | exclusion。"@zh .
ccf:jMetricCode a owl:DatatypeProperty ; rdfs:domain ccf:Judgment ; rdfs:range xsd:string .
ccf:jOp a owl:DatatypeProperty ; rdfs:domain ccf:Judgment ; rdfs:range xsd:string ;
    rdfs:comment "镜像方案1 的 op：> | >= | <。"@zh .
ccf:jOperandKind a owl:DatatypeProperty ; rdfs:domain ccf:Judgment ; rdfs:range xsd:string ;
    rdfs:comment "镜像方案1 的 operandKind：metric_value | threshold_reference | entity_property | enum_value。"@zh .
ccf:jOperandValue a owl:DatatypeProperty ; rdfs:domain ccf:Judgment ; rdfs:range xsd:string ;
    rdfs:comment "镜像方案1 的 operandValue：逐字取自契约（如 \"threshold:acquire_wait_ms_light#warning\"）。"@zh .
ccf:jPredicate a owl:DatatypeProperty ; rdfs:domain ccf:Judgment ; rdfs:range xsd:string ;
    rdfs:comment "契约 meta.predicate_enum：increased | decreased | non_zero | is_true | is_false | in_enum。"@zh .
ccf:jEnumValue a owl:DatatypeProperty ; rdfs:domain ccf:Judgment ; rdfs:range xsd:string .
ccf:jThresholdReference a owl:DatatypeProperty ; rdfs:domain ccf:Judgment ; rdfs:range xsd:string ;
    rdfs:comment "★ 档位必填的引用键：threshold:<阈值名>#<warning|critical>。"@zh .
ccf:jNote a owl:DatatypeProperty ; rdfs:domain ccf:Judgment ; rdfs:range xsd:string .
ccf:rootCauseCode a owl:DatatypeProperty ; rdfs:domain ccf:RootCause ; rdfs:range xsd:string .
ccf:detectionMode a owl:DatatypeProperty ; rdfs:domain ccf:RootCause ; rdfs:range xsd:string ;
    rdfs:comment "契约 leaf_root_causes.detection_mode（本契约里取值 exclusion）。"@zh .
ccf:exclusionRequirementText a owl:DatatypeProperty ; rdfs:domain ccf:Judgment ; rdfs:range xsd:string ;
    rdfs:comment "契约 exclusion_requirements 原文逐条保留（人类可读的排除条件）。"@zh .
ccf:findingCode a owl:DatatypeProperty ; rdfs:domain ccf:Finding ; rdfs:range xsd:string ;
    rdfs:comment "F-001..F-007（docs\\04 §6 规则表）。"@zh .

# ===========================================================================
# 4) 23 个故障模式个体（与契约 fault_modes 集合相等）
# ===========================================================================
ccf:FM-APP-POOL-EXHAUSTED a ccf:FaultMode ;
    ccf:faultModeCode "FM-APP-POOL-EXHAUSTED" ; cco:neutralCode "FM-APP-POOL-EXHAUSTED" ;
    ccf:displayName "应用侧连接池耗尽" ; ccf:faultLayer "App" ; ccf:severity "critical" ;
    ccf:reversible true ; ccf:chainCode "F1" , "F2" ; ccf:fmDetectionMode "mixed" ;
    ccf:fmComponentType cc:JdbcDataSource ; ccf:affects cc:JdbcDataSource ; ccf:affectsSeverity "critical" ;
    ccf:judgedBy ccf:J-pool-1 , ccf:J-pool-2 , ccf:J-pool-3 ;
    ccf:hasJudgmentGroup ccf:G-pool-all ;
    ccf:hasDistinguishingEvidence ccf:J-pool-dist ;
    ccf:betweenGroupsOp "AND" ;
    cco:contractSource "shared/model/fault-modes.yaml#/fault_modes[code=FM-APP-POOL-EXHAUSTED]" ;
    rdfs:label "应用侧连接池耗尽"@zh .

ccf:FM-APP-DS-CONNECT-FAIL a ccf:FaultMode ;
    ccf:faultModeCode "FM-APP-DS-CONNECT-FAIL" ; cco:neutralCode "FM-APP-DS-CONNECT-FAIL" ;
    ccf:displayName "数据源连接建立失败" ; ccf:faultLayer "App" ; ccf:severity "critical" ;
    ccf:reversible false ; ccf:chainCode "F5" , "F6" , "F7" ; ccf:fmDetectionMode "predicate" ;
    ccf:fmComponentType cc:JdbcDataSource ; ccf:affects cc:JdbcDataSource ; ccf:affectsSeverity "critical" ;
    ccf:judgedBy ccf:J-dscf-1 ; ccf:hasJudgmentGroup ccf:G-dscf-all ;
    ccf:hasRootCause ccf:FM-APP-AUTH-INCOMPATIBLE ;
    ccf:note "★ 叶子歧义点：F5(认证)/F6(网络)/F7(切换) 共享此节点，靠子判据区分" ;
    ccf:betweenGroupsOp "AND" ;
    cco:contractSource "shared/model/fault-modes.yaml#/fault_modes[code=FM-APP-DS-CONNECT-FAIL]" ;
    rdfs:label "数据源连接建立失败"@zh .

ccf:FM-APP-ENDPOINT-SLOW a ccf:FaultMode ;
    ccf:faultModeCode "FM-APP-ENDPOINT-SLOW" ; cco:neutralCode "FM-APP-ENDPOINT-SLOW" ;
    ccf:displayName "应用端点响应劣化" ; ccf:faultLayer "App" ; ccf:severity "major" ;
    ccf:reversible true ; ccf:chainCode "F1" , "F2" , "F3" , "F4" , "F5" , "F6" , "F7" ;
    ccf:fmDetectionMode "threshold" ;
    ccf:fmComponentType cc:AppEndpoint ; ccf:affects cc:AppEndpoint ; ccf:affectsSeverity "major" ;
    ccf:judgedBy ccf:J-eps-1 ; ccf:hasJudgmentGroup ccf:G-eps-all ;
    ccf:note "最上层症状，7 条链的共同出口" ;
    ccf:betweenGroupsOp "AND" ;
    cco:contractSource "shared/model/fault-modes.yaml#/fault_modes[code=FM-APP-ENDPOINT-SLOW]" ;
    rdfs:label "应用端点响应劣化"@zh .

ccf:FM-APP-INSTANCE-RESTART a ccf:FaultMode ;
    ccf:faultModeCode "FM-APP-INSTANCE-RESTART" ; cco:neutralCode "FM-APP-INSTANCE-RESTART" ;
    ccf:displayName "应用实例重启" ; ccf:faultLayer "App" ; ccf:severity "major" ;
    ccf:reversible true ; ccf:chainCode "F4" ; ccf:fmDetectionMode "predicate" ;
    ccf:fmComponentType cc:AppInstance ; ccf:affects cc:AppInstance ; ccf:affectsSeverity "major" ;
    ccf:judgedBy ccf:J-restart-a1 , ccf:J-restart-b1 ;
    ccf:hasJudgmentGroup ccf:G-restart-any , ccf:G-restart-all ;
    ccf:note "★ X-5（v1.0.3 裁定）：契约 detect 同级并列 any_of 与 all_of ⇒ 组内 AND/OR、**组间 AND**、缺省组中性成立" ;
    skos:note "契约本条**没有** note 字段；上式是方案2 侧对 X-5 的处置说明（非契约原文）。"@zh ;
    ccf:betweenGroupsOp "AND" ;
    cco:contractSource "shared/model/fault-modes.yaml#/fault_modes[code=FM-APP-INSTANCE-RESTART]" ;
    rdfs:label "应用实例重启"@zh .

