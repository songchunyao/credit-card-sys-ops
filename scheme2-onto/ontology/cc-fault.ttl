# ★ 23 个故障模式互斥（OWL 原生公理；方案1 的 LPG 无此语义，只能在代码里断言）
[ a owl:AllDifferent ;
  owl:distinctMembers ( ccf:FM-APP-POOL-EXHAUSTED ccf:FM-APP-DS-CONNECT-FAIL ccf:FM-APP-ENDPOINT-SLOW
    ccf:FM-APP-INSTANCE-RESTART ccf:FM-APP-HEAP-PRESSURE ccf:FM-CTR-OOM-KILLED ccf:FM-CTR-CPU-THROTTLED
    ccf:FM-CTR-NET-UNREACHABLE ccf:FM-HOST-CPU-CONTENTION ccf:FM-HOST-MEM-PRESSURE ccf:FM-DB-SLOW-QUERY
    ccf:FM-DB-SESSION-POOL-FULL ccf:FM-DB-LOCK-WAIT ccf:FM-DB-INSTANCE-DOWN
    ccf:FM-DB-DEADLOCK ccf:FM-DB-IDLE-IN-TX ccf:FM-DB-SEQ-SCAN ccf:FM-DB-ROLLBACK-STORM
    ccf:FM-HOST-DISK-FULL ccf:FM-HOST-DISK-IO-ERROR ccf:FM-HOST-NET-IFACE-DOWN
    ccf:FM-DB-REPLICATION-LAG ccf:FM-DB-UNUSED-INDEX ) ] .

# ===========================================================================
# 5) 判据组（16 个：13 个 all_of + 3 个 any_of；restart/net 两模式各含两组，
#    down 只含 any_of —— 组间由 ccf:betweenGroupsOp 固定为 AND）
# ===========================================================================
ccf:G-pool-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-APP-POOL-EXHAUSTED#all_of" ;
    ccf:hasJudgment ccf:J-pool-1 , ccf:J-pool-2 , ccf:J-pool-3 .
ccf:G-dscf-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-APP-DS-CONNECT-FAIL#all_of" ;
    ccf:hasJudgment ccf:J-dscf-1 .
ccf:G-eps-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-APP-ENDPOINT-SLOW#all_of" ;
    ccf:hasJudgment ccf:J-eps-1 .
ccf:G-restart-any a ccf:JudgmentGroup ; ccf:groupKind "any_of" ; ccf:groupOp "OR" ; cco:neutralCode "FM-APP-INSTANCE-RESTART#any_of" ;
    ccf:hasJudgment ccf:J-restart-a1 .
ccf:G-restart-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-APP-INSTANCE-RESTART#all_of" ;
    ccf:hasJudgment ccf:J-restart-b1 .
ccf:G-heap-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-APP-HEAP-PRESSURE#all_of" ;
    ccf:hasJudgment ccf:J-heap-1 , ccf:J-heap-2 .
ccf:G-oom-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-CTR-OOM-KILLED#all_of" ;
    ccf:hasJudgment ccf:J-oom-1 .
ccf:G-throttle-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-CTR-CPU-THROTTLED#all_of" ;
    ccf:hasJudgment ccf:J-throttle-1 .
ccf:G-net-any a ccf:JudgmentGroup ; ccf:groupKind "any_of" ; ccf:groupOp "OR" ; cco:neutralCode "FM-CTR-NET-UNREACHABLE#any_of" ;
    ccf:hasJudgment ccf:J-net-a1 .
ccf:G-net-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-CTR-NET-UNREACHABLE#all_of" ;
    ccf:hasJudgment ccf:J-net-b1 .
ccf:G-hostcpu-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-HOST-CPU-CONTENTION#all_of" ;
    ccf:hasJudgment ccf:J-hostcpu-1 , ccf:J-hostcpu-2 .
ccf:G-hostmem-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-HOST-MEM-PRESSURE#all_of" ;
    ccf:hasJudgment ccf:J-hostmem-1 .
ccf:G-slowq-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-DB-SLOW-QUERY#all_of" ;
    ccf:hasJudgment ccf:J-slowq-1 .
ccf:G-poolfull-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-DB-SESSION-POOL-FULL#all_of" ;
    ccf:hasJudgment ccf:J-poolfull-1 , ccf:J-poolfull-2 .
ccf:G-lock-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-DB-LOCK-WAIT#all_of" ;
    ccf:hasJudgment ccf:J-lock-1 , ccf:J-lock-2 .
ccf:G-down-any a ccf:JudgmentGroup ; ccf:groupKind "any_of" ; ccf:groupOp "OR" ; cco:neutralCode "FM-DB-INSTANCE-DOWN#any_of" ;
    ccf:hasJudgment ccf:J-down-a1 , ccf:J-down-b1 .
ccf:G-hostdiskfull-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-HOST-DISK-FULL#all_of" ;
    ccf:hasJudgment ccf:J-hostdiskfull-1 .
ccf:G-hostdiskioerror-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-HOST-DISK-IO-ERROR#all_of" ;
    ccf:hasJudgment ccf:J-hostdiskioerror-1 .
ccf:G-hostnetifacedown-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-HOST-NET-IFACE-DOWN#all_of" ;
    ccf:hasJudgment ccf:J-hostnetifacedown-1 .
ccf:G-dbreplicationlag-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-DB-REPLICATION-LAG#all_of" ;
    ccf:hasJudgment ccf:J-dbreplicationlag-1 .
ccf:G-dbunusedindex-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-DB-UNUSED-INDEX#all_of" ;
    ccf:hasJudgment ccf:J-dbunusedindex-1 .
ccf:G-deadlock-all a ccf:JudgmentGroup ; ccf:groupKind "all_of" ; ccf:groupOp "AND" ; cco:neutralCode "FM-DB-DEADLOCK#all_of" ;
    ccf:hasJudgment ccf:J-deadlock-1 .
