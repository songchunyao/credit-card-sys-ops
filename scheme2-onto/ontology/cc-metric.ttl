# ===========================================================================
# 6) 12 个阈值名 + 24 个档位节点（契约 v1.0.2；★ 计数随契约版本提升而提升，
#    不得改成「自己数自己」的自证式动态计数）
#
#    2 类绑定方式（与 fault-modes.yaml#meta.threshold_policy.binding_modes 对齐）：
#      · threshold_node：指标 -ccm:hasThreshold-> 阈值名 -ccm:warningTier/criticalTier-> 档位
#      · entity_property：阈值即实体自身属性（app.datasource.acquire_wait_ms→maxPoolSize 等）
#    档位节点必带 ccm:tierReference（"threshold:<名>#<档位>"，契约引用键，档位必填）；
#    未标定档（warning/critical 皆 null）带 ccm:uncalibrated true 且**不写** ccm:thresholdValue。
#   ★ 档位必填：每个档位节点带 ccm:tierReference "threshold:<名>#<warning|critical>"
#   ★ 2026-10-12：acquire_wait_ms_light **已标定**（520/1560）；
#     余 2 档 warning/critical 仍为 null（load1_per_core_light / qps_high）⇒ 仍标 ccm:uncalibrated true。
# ===========================================================================
ccm:t_acquire_wait_ms_light a ccm:Threshold ; ccm:thresholdName "acquire_wait_ms_light" ;
    ccm:thresholdMetric ccm:m_app_datasource_acquire_wait_ms ;
    ccm:warningTier ccm:t_acquire_wait_ms_light_warning ; ccm:criticalTier ccm:t_acquire_wait_ms_light_critical ;
    ccm:rationale "★ 2026-10-12 标定（原两档 null ⇒ FM-APP-POOL-EXHAUSTED 不可机判）：样本 = 真机历史日志全部轮次的 `连接池获取 … 耗时=Xms`（n=91），按应用自身判据分层剔除启动填充：INFO 层 n=64 健康期 P95=260ms × k=2.0 ⇒ warning=520；warning × k_crit=3.0 ⇒ critical=1560。交叉验证：应用自判『偏慢』最小耗时 532ms（相差 2.3%）。"@zh .
ccm:t_acquire_wait_ms_light_warning a ccm:WarningThreshold ; ccm:tierOf ccm:t_acquire_wait_ms_light ;
    ccm:tierReference "threshold:acquire_wait_ms_light#warning" ; ccm:thresholdValue 520 .
ccm:t_acquire_wait_ms_light_critical a ccm:CriticalThreshold ; ccm:tierOf ccm:t_acquire_wait_ms_light ;
    ccm:tierReference "threshold:acquire_wait_ms_light#critical" ; ccm:thresholdValue 1560 .
ccm:t_fs_usage_pct_light a ccm:Threshold ; ccm:thresholdName "fs_usage_pct_light" ;
    ccm:thresholdMetric ccm:m_host_fs_max_used_pct ;
    ccm:warningTier ccm:t_fs_usage_pct_light_warning ; ccm:criticalTier ccm:t_fs_usage_pct_light_critical ;
    ccm:rationale "★ 2026-10-12 标定（原两档 null ⇒ FM-APP-POOL-EXHAUSTED 不可机判）：样本 = 真机历史日志全部轮次的 `连接池获取 … 耗时=Xms`（n=91），按应用自身判据分层剔除启动填充：INFO 层 n=64 健康期 P95=260ms × k=2.0 ⇒ warning=80；warning × k_crit=3.0 ⇒ critical=90。交叉验证：应用自判『偏慢』最小耗时 532ms（相差 2.3%）。"@zh .
ccm:t_fs_usage_pct_light_warning a ccm:WarningThreshold ; ccm:tierOf ccm:t_fs_usage_pct_light ;
    ccm:tierReference "threshold:fs_usage_pct_light#warning" ; ccm:thresholdValue 80 .
ccm:t_fs_usage_pct_light_critical a ccm:CriticalThreshold ; ccm:tierOf ccm:t_fs_usage_pct_light ;
    ccm:tierReference "threshold:fs_usage_pct_light#critical" ; ccm:thresholdValue 90 .

ccm:t_session_used_ratio_light a ccm:Threshold ; ccm:thresholdName "session_used_ratio_light" ;
    ccm:thresholdMetric ccm:m_db_pool_session_used_ratio ;
    ccm:warningTier ccm:t_session_used_ratio_light_warning ; ccm:criticalTier ccm:t_session_used_ratio_light_critical ;
    ccm:rationale "★ 2026-10-13 按契约对齐（原 0.70/0.85 为陈旧工程基线）：健康期近空闲 ⇒ 取「会话池已用一半」这一运维有意义的界线 0.5；×k_crit=3.0 被域上限 1 封顶 ⇒ critical=1。出处 shared/model/fault-modes.yaml#thresholds[session_used_ratio_light]"@zh .
ccm:t_session_used_ratio_light_warning a ccm:WarningThreshold ; ccm:tierOf ccm:t_session_used_ratio_light ;
    ccm:tierReference "threshold:session_used_ratio_light#warning" ; ccm:thresholdValue "0.5"^^xsd:decimal .
ccm:t_session_used_ratio_light_critical a ccm:CriticalThreshold ; ccm:tierOf ccm:t_session_used_ratio_light ;
    ccm:tierReference "threshold:session_used_ratio_light#critical" ; ccm:thresholdValue "1"^^xsd:decimal .

ccm:t_session_used_ratio_severe a ccm:Threshold ; ccm:thresholdName "session_used_ratio_severe" ;
    ccm:thresholdMetric ccm:m_db_pool_session_used_ratio ;
    ccm:warningTier ccm:t_session_used_ratio_severe_warning ; ccm:criticalTier ccm:t_session_used_ratio_severe_critical ;
    ccm:rationale "★ 2026-10-13 按契约对齐（原 0.85/0.95 为陈旧值）：severe 与 light 必须分开声明，否则 critical=warning×3 会被域上限 1.0 封顶而两档取值相同 ⇒ warning=0.8（池只剩两成余量）、critical=1。出处 shared/model/fault-modes.yaml#thresholds[session_used_ratio_severe]"@zh .
ccm:t_session_used_ratio_severe_warning a ccm:WarningThreshold ; ccm:tierOf ccm:t_session_used_ratio_severe ;
    ccm:tierReference "threshold:session_used_ratio_severe#warning" ; ccm:thresholdValue "0.8"^^xsd:decimal .
ccm:t_session_used_ratio_severe_critical a ccm:CriticalThreshold ; ccm:tierOf ccm:t_session_used_ratio_severe ;
    ccm:tierReference "threshold:session_used_ratio_severe#critical" ; ccm:thresholdValue "1"^^xsd:decimal .

ccm:t_heap_used_ratio_light a ccm:Threshold ; ccm:thresholdName "heap_used_ratio_light" ;
    ccm:thresholdMetric ccm:m_app_heap_used_ratio ;
    ccm:warningTier ccm:t_heap_used_ratio_light_warning ; ccm:criticalTier ccm:t_heap_used_ratio_light_critical ;
    ccm:rationale "待标定：JVM 常规经验值，需实测 GC 行为后定档"@zh .
ccm:t_heap_used_ratio_light_warning a ccm:WarningThreshold ; ccm:tierOf ccm:t_heap_used_ratio_light ;
    ccm:tierReference "threshold:heap_used_ratio_light#warning" ; ccm:thresholdValue "0.75"^^xsd:decimal .
ccm:t_heap_used_ratio_light_critical a ccm:CriticalThreshold ; ccm:tierOf ccm:t_heap_used_ratio_light ;
    ccm:tierReference "threshold:heap_used_ratio_light#critical" ; ccm:thresholdValue "0.90"^^xsd:decimal .

ccm:t_gc_pause_ms_light a ccm:Threshold ; ccm:thresholdName "gc_pause_ms_light" ;
    ccm:thresholdMetric ccm:m_app_gc_pause_ms ;
    ccm:warningTier ccm:t_gc_pause_ms_light_warning ; ccm:criticalTier ccm:t_gc_pause_ms_light_critical ;
    ccm:rationale "待标定"@zh .
ccm:t_gc_pause_ms_light_warning a ccm:WarningThreshold ; ccm:tierOf ccm:t_gc_pause_ms_light ;
    ccm:tierReference "threshold:gc_pause_ms_light#warning" ; ccm:thresholdValue "200"^^xsd:decimal .
ccm:t_gc_pause_ms_light_critical a ccm:CriticalThreshold ; ccm:tierOf ccm:t_gc_pause_ms_light ;
    ccm:tierReference "threshold:gc_pause_ms_light#critical" ; ccm:thresholdValue "1000"^^xsd:decimal .

ccm:t_load1_per_core_light a ccm:Threshold ; ccm:thresholdName "load1_per_core_light" ;
    ccm:thresholdMetric ccm:m_host_load1 ;
    ccm:warningTier ccm:t_load1_per_core_light_warning ; ccm:criticalTier ccm:t_load1_per_core_light_critical ;
    ccm:rationale "必须按 Host.cpuCores 归一化，不能硬编码；标定方式：load1 > cpuCores * k"@zh .
ccm:t_load1_per_core_light_warning a ccm:WarningThreshold ; ccm:tierOf ccm:t_load1_per_core_light ;
    ccm:tierReference "threshold:load1_per_core_light#warning" ; ccm:uncalibrated true .
ccm:t_load1_per_core_light_critical a ccm:CriticalThreshold ; ccm:tierOf ccm:t_load1_per_core_light ;
    ccm:tierReference "threshold:load1_per_core_light#critical" ; ccm:uncalibrated true .

ccm:t_cpu_usage_ratio_severe a ccm:Threshold ; ccm:thresholdName "cpu_usage_ratio_severe" ;
    ccm:thresholdMetric ccm:m_host_cpu_usage_ratio ;
    ccm:warningTier ccm:t_cpu_usage_ratio_severe_warning ; ccm:criticalTier ccm:t_cpu_usage_ratio_severe_critical ;
    ccm:rationale "★ 2026-10-13 按契约对齐（原 0.80/0.90 为陈旧值，量级差约 3.5×；旧值源自「旧项目写 node.cpu_usage > 90 而实测 [13.6, 21.01]%，几乎永不命中」）：warning=0.2284 / critical=0.6852，由健康期分布 P95×k 标定。出处 shared/model/fault-modes.yaml#thresholds[cpu_usage_ratio_severe]"@zh .
ccm:t_cpu_usage_ratio_severe_warning a ccm:WarningThreshold ; ccm:tierOf ccm:t_cpu_usage_ratio_severe ;
    ccm:tierReference "threshold:cpu_usage_ratio_severe#warning" ; ccm:thresholdValue "0.2284"^^xsd:decimal .
ccm:t_cpu_usage_ratio_severe_critical a ccm:CriticalThreshold ; ccm:tierOf ccm:t_cpu_usage_ratio_severe ;
    ccm:tierReference "threshold:cpu_usage_ratio_severe#critical" ; ccm:thresholdValue "0.6852"^^xsd:decimal .

ccm:t_mem_available_ratio_severe a ccm:Threshold ; ccm:thresholdName "mem_available_ratio_severe" ;
    ccm:thresholdMetric ccm:m_host_mem_available_ratio ;
    ccm:warningTier ccm:t_mem_available_ratio_severe_warning ; ccm:criticalTier ccm:t_mem_available_ratio_severe_critical ;
    ccm:rationale "待标定"@zh .
ccm:t_mem_available_ratio_severe_warning a ccm:WarningThreshold ; ccm:tierOf ccm:t_mem_available_ratio_severe ;
    ccm:tierReference "threshold:mem_available_ratio_severe#warning" ; ccm:thresholdValue "0.15"^^xsd:decimal .
ccm:t_mem_available_ratio_severe_critical a ccm:CriticalThreshold ; ccm:tierOf ccm:t_mem_available_ratio_severe ;
    ccm:tierReference "threshold:mem_available_ratio_severe#critical" ; ccm:thresholdValue "0.05"^^xsd:decimal .

ccm:t_mean_exec_ms_light a ccm:Threshold ; ccm:thresholdName "mean_exec_ms_light" ;
    ccm:thresholdMetric ccm:m_db_query_mean_exec_ms ;
    ccm:warningTier ccm:t_mean_exec_ms_light_warning ; ccm:criticalTier ccm:t_mean_exec_ms_light_critical ;
    ccm:rationale "待标定：既有项目档位 mean_exec_time_ms_light = (100, 1000)ms，但实测慢 SQL 平均 30.8s，档位需重设"@zh .
ccm:t_mean_exec_ms_light_warning a ccm:WarningThreshold ; ccm:tierOf ccm:t_mean_exec_ms_light ;
    ccm:tierReference "threshold:mean_exec_ms_light#warning" ; ccm:thresholdValue "1000"^^xsd:decimal .
ccm:t_mean_exec_ms_light_critical a ccm:CriticalThreshold ; ccm:tierOf ccm:t_mean_exec_ms_light ;
    ccm:tierReference "threshold:mean_exec_ms_light#critical" ; ccm:thresholdValue "10000"^^xsd:decimal .

ccm:t_xact_age_s_light a ccm:Threshold ; ccm:thresholdName "xact_age_s_light" ;
    ccm:thresholdMetric ccm:m_db_session_xact_age_s ;
    ccm:warningTier ccm:t_xact_age_s_light_warning ; ccm:criticalTier ccm:t_xact_age_s_light_critical ;
    ccm:rationale "待标定"@zh .
ccm:t_xact_age_s_light_warning a ccm:WarningThreshold ; ccm:tierOf ccm:t_xact_age_s_light ;
    ccm:tierReference "threshold:xact_age_s_light#warning" ; ccm:thresholdValue "300"^^xsd:decimal .
ccm:t_xact_age_s_light_critical a ccm:CriticalThreshold ; ccm:tierOf ccm:t_xact_age_s_light ;
    ccm:tierReference "threshold:xact_age_s_light#critical" ; ccm:thresholdValue "900"^^xsd:decimal .

ccm:t_qps_high a ccm:Threshold ; ccm:thresholdName "qps_high" ;
    ccm:thresholdMetric ccm:m_app_endpoint_qps ;
    ccm:warningTier ccm:t_qps_high_warning ; ccm:criticalTier ccm:t_qps_high_critical ;
    ccm:rationale "待标定：需应用侧真实 QPS 值域。用于 causal-edges.yaml 的 E6 条件边（高并发触发正反馈环）。★ 该条在 v1.0.0 时被 E6 引用但本表未定义——属悬空引用，由 contract_gates.py（G3）发现，v1.0.1 补齐"@zh .
ccm:t_qps_high_warning a ccm:WarningThreshold ; ccm:tierOf ccm:t_qps_high ;
    ccm:tierReference "threshold:qps_high#warning" ; ccm:uncalibrated true .
ccm:t_qps_high_critical a ccm:CriticalThreshold ; ccm:tierOf ccm:t_qps_high ;
    ccm:tierReference "threshold:qps_high#critical" ; ccm:uncalibrated true .

# --- v1.0.2 新增（第 12 档）：docs/04:348 的 r02 示例引用 dead_tuple_ratio_light，
#     但 v1.0.1 契约里没有该个体（悬空引用）⇒ 契约 v1.0.2 补齐。
#     ★ 2026-10-13 更正：契约 v1.0.3 已给出该档标定（0.1/0.3）⇒ 原来登记的
#     `ccm:uncalibrated true`（「待标定、当前不可机判」）**已过期**，会使 ONTO 侧
#     把该判据恒判 UNK（而 KG 侧按契约值正常求值）⇒ 两侧 `determined` 不一致。
#     现按契约写入数值。出处 shared/model/fault-modes.yaml#thresholds[dead_tuple_ratio_light]。
ccm:t_dead_tuple_ratio_light a ccm:Threshold ; ccm:thresholdName "dead_tuple_ratio_light" ;
    ccm:thresholdMetric ccm:m_db_table_dead_tuple_ratio ;
    ccm:warningTier ccm:t_dead_tuple_ratio_light_warning ; ccm:criticalTier ccm:t_dead_tuple_ratio_light_critical ;
    ccm:rationale "★ 2026-10-13 按契约对齐（原登记为待标定 uncalibrated）：warning=0.1 / critical=0.3。出处 shared/model/fault-modes.yaml#thresholds[dead_tuple_ratio_light]"@zh .
ccm:t_dead_tuple_ratio_light_warning a ccm:WarningThreshold ; ccm:tierOf ccm:t_dead_tuple_ratio_light ;
    ccm:tierReference "threshold:dead_tuple_ratio_light#warning" ; ccm:thresholdValue "0.1"^^xsd:decimal ;
    rdfs:comment "按契约标定：0.1（warning 档）。"@zh .
ccm:t_dead_tuple_ratio_light_critical a ccm:CriticalThreshold ; ccm:tierOf ccm:t_dead_tuple_ratio_light ;
    ccm:tierReference "threshold:dead_tuple_ratio_light#critical" ; ccm:thresholdValue "0.3"^^xsd:decimal ;
    rdfs:comment "按契约标定：0.3（critical 档）。"@zh .

# ===========================================================================
# 6b) 非零基线常量（predicate:non_zero 的零点来源）
#   ★ 为什么需要：fault-modes.yaml#meta.predicate_enum 含 non_zero，而
#     threshold_policy.hardcode_forbidden=true 禁止在规则里写数字字面量。
#     零点本身不是「阈值」（没有档位语义），所以不为它伪造一档 threshold，
#     而是单列 ccm:BaselineConstant 类 + ccm:baselineValue 属性；
#     规则用 ccm:tierReference "baseline:counter_non_zero" 引用它。
#   ★ 这是方案2 自定词汇（契约未定义 non_zero 的零点载体），进报告诚实清单。
# ===========================================================================
ccm:BaselineConstant a owl:Class ;
    rdfs:subClassOf ccm:MetricRelatedArtifact ;
    rdfs:label "基线常量"@zh ;
    rdfs:comment "给 predicate:non_zero 提供零点的 TBox 常量（值住在本体里，规则内零数字字面量）。"@zh ;
    cco:rigidity "+R" ; cco:identity "+I" ; cco:unity "+U" ; cco:dependence "+D" ;
    cco:identityCriterion "基线常量名：ccm:tierReference（形如 baseline:counter_non_zero）" .
ccm:baselineValue a owl:DatatypeProperty ; rdfs:domain ccm:BaselineConstant ; rdfs:range xsd:decimal ;
    rdfs:label "基线值"@zh .
ccm:b_counter_non_zero a ccm:BaselineConstant ;
    ccm:tierReference "baseline:counter_non_zero" ;
    ccm:baselineValue "0"^^xsd:decimal ;
    ccm:rationale "单位「次」的窗口内累计计数：非零即表示窗口内发生了该事件；零点作为常量而非阈值。"@zh ;
    rdfs:label "计数值非零基线"@zh .

# ===========================================================================
# 7) SOSA 挂接（3 条属性对齐子公理）—— U2 未结案的最小挂接
#   ★ 对齐用 rdfs:subPropertyOf（OWL 原生），使本方案属性获得 SOSA 语义，
#     同时**不**要求 ABox 额外制造观测个体（避免 U2 的「多一跳」）。
# ===========================================================================
ccm:observedMetric a owl:ObjectProperty ; rdfs:subPropertyOf sosa:observedProperty ;
    rdfs:domain ccm:MetricObservation ; rdfs:range ccm:Metric ;
    rdfs:label "观测的指标"@zh .
ccm:observedEntity a owl:ObjectProperty ; rdfs:subPropertyOf sosa:hasFeatureOfInterest ;
    rdfs:domain ccm:MetricObservation ; rdfs:range cco:Entity ;
    rdfs:label "观测的对象"@zh .
ccm:observedValue a owl:DatatypeProperty ; rdfs:subPropertyOf sosa:hasSimpleResult ;
    rdfs:domain ccm:MetricObservation ; rdfs:range rdfs:Literal ;
    rdfs:label "观测结果"@zh .

# ===========================================================================
# 8) 契约缺口与偏差（只报告，不就地改契约）
# ===========================================================================
# X-1  docs/04 §6 prologue 的 cct:/cco#obs 前缀不在映射表 ⇒ 阈值落 ccm:（见文件头）。
# X-2  docs/04 §6 r02 示例把 db.table.dead_tuple_ratio 写进慢查询判据，且含 FILTER(>0)
#      数字字面量 ⇒ 本实现严格按 fault-modes.yaml 的 detect，且规则内零数字字面量。
# X-7  fault-modes.yaml 的 detect 用 predicate:increased/decreased，但 ccf.schema.json
#      与观测对象里**没有** prev/delta/baseline 字段（单快照）⇒ 该谓词的物化方式
#      契约未定义。本实现在 rules/ 内以「同实体同指标按 cc:capturedAt 时序比较」
#      物化（见 r03/r04/r06/r07 与报告诚实清单）；单快照下必产 0 条，
#      属数据/契约缺口，不是实现缺陷。

# ===========================================================================
# OWL 原生键公理（镜像 docs/03:68 的 Neo4j 唯一约束：
#   CREATE CONSTRAINT cc_uq_metric_code IF NOT EXISTS FOR (n:CC_Metric) REQUIRE n.metricCode IS UNIQUE）
# ===========================================================================
ccm:Metric owl:hasKey ( ccm:metricCode ) .
