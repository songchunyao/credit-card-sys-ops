# ============================================================================
# scheme2-onto/ontology/cc-metric.ttl  ·  方案2 指标与观测模块（ccm:）
# ----------------------------------------------------------------------------
# 职责（docs/04 §3 模块表）：70 个指标 + 阈值个体 + sosa:Observation 挂接。
# 命名空间（逐字取自 type-map.yaml#namespaces.onto）：ccm = .../onto/metric#
# 上游契约：shared/model/metrics.yaml（70 指标：code/object/layer/unit/type/…
#           + threshold_policy.hardcode_forbidden=true）
#           shared/model/fault-modes.yaml#thresholds（12 档，warning/critical/rationale；
#           ★ 计数随契约版本提升：v1.0.1=11 档 → v1.0.2=12 档，新增 dead_tuple_ratio_light）
#
# ★ X-1（docs/04 §6 prologue 声明 cct: <.../threshold#> 与 cco: <.../obs#>，
#   两者都不在 type-map#namespaces 允许集合内）⇒ 阈值个体落 ccm:，
#   命名 ccm:t_<阈值名>（档位节点 ccm:t_<阈值名>_<warning|critical>）。
#   不新造命名空间。
#
# ★ U2（docs/04 §10 待确认：是否引入 SOSA）的落地口径 —— 本模块**如实标注为未结案**，
#   但按 §1「规范栈必须」给最小挂接（不引入额外观测个体层）：
#     cc:Evidence          rdfs:subClassOf ccm:MetricObservation   （证据即观测记录）
#     ccm:MetricObservation rdfs:subClassOf sosa:Observation
#     + 3 条属性对齐子公理（见文件末尾）。若 U2 最终裁为「不引入 SOSA」，
#       需删除的公理仅这 4 条（成本已记账，见报告）。
#   ★ 用 dcterms:references 而**非** owl:imports 引用 SOSA：
#     owl:imports 会让装载器尝试联网抓取，与「门禁：装载前必须本地校验通过」冲突。
#
# ★ OWL 原生 vs SHACL 补足（docs/04 §D6，必须分开计）：
#   OWL 原生（本模块）：rdfs:domain/range、owl:unionOf 域、rdfs:subClassOf、
#     owl:disjointWith（阈值档位互斥）、子属性对齐公理（⊑ sosa:）。
#   SHACL 补足（ccs:，不在本模块）：key_attrs 的 sh:minCount 1（OWL-RL 无 min 侧
#     基数）、枚举 sh:in、数值区间 sh:minInclusive/maxInclusive、sh:closed 的 CWA。
# ============================================================================
@prefix ccm:     <https://credit-card-ops.ai/onto/metric#> .
@prefix cc:      <https://credit-card-ops.ai/onto/topology#> .
@prefix cco:     <https://credit-card-ops.ai/onto/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .

# ===========================================================================
# 1) 模块本体声明
# ===========================================================================
ccm: a owl:Ontology , dcat:Dataset ;
    dcterms:title "信用卡跨层运维本体 · 指标模块（cc-metric）"@zh ;
    dcterms:description "70 指标（含 domain/range 与 unionOf 共享域）+ 12 阈值档（24 档位节点，契约 v1.0.2）+ 1 个非零基线常量 + SOSA 最小挂接。"@zh ;
    dcterms:references <http://www.w3.org/ns/sosa/> ;
    cco:contractSource "shared/model/metrics.yaml + shared/model/fault-modes.yaml#thresholds" ;
    skos:note "阈值个体按 X-1 落在 ccm:（docs\\04 §6 声明的 cct:/cco#obs 前缀不在映射表内）；档位以 ccm:tierReference 字符串 \"threshold:<名>#<warning|critical>\" 作为规则连接键，规则内零数字字面量。"@zh .

# ===========================================================================
# 2) 类（6 个名词类 + 1 个观测挂接类）
# ===========================================================================
ccm:Metric a owl:Class ;
    rdfs:subClassOf cco:DependentEntity ;
    rdfs:label "指标件"@zh ;
    rdfs:comment "一个指标 = 一条对某类实体的可观测性质（68 个属性 IRI 承载 91 个指标：ccm:cpuUsageRatio 被 3 个指标复用）。"@zh ;
    cco:rigidity "+R" ; cco:identity "+I" ; cco:unity "+U" ; cco:dependence "+D" ;
    cco:identityCriterion "指标码 metricCode" ;
    cco:contractSource "metrics.yaml#/metrics" .

ccm:MetricRelatedArtifact a owl:Class ;
    rdfs:subClassOf cco:DependentEntity ;
    rdfs:label "指标相关构件"@zh ;
    cco:isAbstract true ;
    rdfs:comment "与指标相关但本身不是指标的可命名构件（阈值名、档位、基线常量）的共同父类。"@zh ;
    cco:rigidity "+R" ; cco:identity "+I" ; cco:unity "+U" ; cco:dependence "+D" ;
    cco:identityCriterion "构件名：阈值名 / 档位码（<阈值名>#warning|critical）/ 基线常量名" ;
    cco:contractSource "fault-modes.yaml#/thresholds（父类为方案2 自定，进报告诚实清单）" .

ccm:Threshold a owl:Class ;
    rdfs:subClassOf ccm:MetricRelatedArtifact ;
    rdfs:label "阈值档"@zh ;
    rdfs:comment "一个阈值名（如 mean_exec_ms_light）下挂 warning / critical 两个档位节点。"@zh ;
    cco:rigidity "+R" ; cco:identity "+I" ; cco:unity "+U" ; cco:dependence "+D" ;
    cco:identityCriterion "阈值名 thresholdName" ;
    cco:contractSource "fault-modes.yaml#/thresholds" .

ccm:WarningThreshold a owl:Class ;
    rdfs:subClassOf ccm:Threshold ;
    owl:disjointWith ccm:CriticalThreshold ;
    rdfs:label "warning 档"@zh ;
    rdfs:comment "命名约定：*_light → warning（fault-modes.yaml#meta，docs\\04 §6）。"@zh ;
    cco:rigidity "+R" ; cco:identity "+I" ; cco:unity "+U" ; cco:dependence "+D" ;
    cco:identityCriterion "档位三元引用 threshold:<名>#warning" ;
    cco:contractSource "fault-modes.yaml#/thresholds (命名约定 *_light → warning)" .

ccm:CriticalThreshold a owl:Class ;
    rdfs:subClassOf ccm:Threshold ;
    rdfs:label "critical 档"@zh ;
    rdfs:comment "命名约定：*_severe / *_high → critical。"@zh ;
    cco:rigidity "+R" ; cco:identity "+I" ; cco:unity "+U" ; cco:dependence "+D" ;
    cco:identityCriterion "档位三元引用 threshold:<名>#critical" ;
    cco:contractSource "fault-modes.yaml#/thresholds (命名约定 *_severe/*_high → critical)" .

ccm:MetricObservation a owl:Class ;
    rdfs:subClassOf sosa:Observation , cco:Occurrent ;
    rdfs:label "指标观测"@zh ;
    rdfs:comment "★ U6 已结案（每条 CCF 观测一个证据个体、不聚合）⇒ 真机落成形态是 cc:Evidence；故此处以 cc:Evidence rdfs:subClassOf ccm:MetricObservation 把两者接上（不额外制造观测个体层，避开 U2 的『多一跳』成本）。"@zh ;
    cco:contractSource "docs\\04 §1 规范栈（SOSA 必须）+ §10 U2/U6" .

cc:Evidence rdfs:subClassOf ccm:MetricObservation ;
    rdfs:comment "★ U2 挂接点（跨模块公理，写在指标模块以便集中审计）。"@zh .

# ===========================================================================
# 3) 指标数据属性（68 条属性 IRI 承载 91 个指标）
#    domain = 指标 object 字段对应的类；range = type-map 的 xsd
#    ★ 跨类型共享属性用 owl:unionOf 域（否则 OWL 会强制单一 domain ⇒ 归错类）
# ===========================================================================
# ---- 应用层 / AppInstance ----
ccm:uptimeS a owl:DatatypeProperty ; rdfs:domain cc:AppInstance ; rdfs:range xsd:integer .
ccm:heapUsedRatio a owl:DatatypeProperty ; rdfs:domain cc:AppInstance ; rdfs:range xsd:decimal .
ccm:gcPauseMs a owl:DatatypeProperty ; rdfs:domain cc:AppInstance ; rdfs:range xsd:decimal .
ccm:threadCount a owl:DatatypeProperty ; rdfs:domain cc:AppInstance ; rdfs:range xsd:integer .
# ---- 应用层 / AppEndpoint ----
ccm:p99Ms a owl:DatatypeProperty ; rdfs:domain cc:AppEndpoint ; rdfs:range xsd:decimal .
ccm:errorRate a owl:DatatypeProperty ; rdfs:domain cc:AppEndpoint ; rdfs:range xsd:decimal .
ccm:qps a owl:DatatypeProperty ; rdfs:domain cc:AppEndpoint ; rdfs:range xsd:decimal .
ccm:tps a owl:DatatypeProperty ; rdfs:domain cc:AppEndpoint ; rdfs:range xsd:decimal .
ccm:p50Ms a owl:DatatypeProperty ; rdfs:domain cc:AppEndpoint ; rdfs:range xsd:decimal .
ccm:p95Ms a owl:DatatypeProperty ; rdfs:domain cc:AppEndpoint ; rdfs:range xsd:decimal .
ccm:maxMs a owl:DatatypeProperty ; rdfs:domain cc:AppEndpoint ; rdfs:range xsd:decimal .
ccm:successTotal a owl:DatatypeProperty ; rdfs:domain cc:AppEndpoint ; rdfs:range xsd:integer .
ccm:failTotal a owl:DatatypeProperty ; rdfs:domain cc:AppEndpoint ; rdfs:range xsd:integer .
ccm:fsMaxUsedPct a owl:DatatypeProperty ; rdfs:domain cc:Host ; rdfs:range xsd:decimal .
ccm:diskIoErrorsTotal a owl:DatatypeProperty ; rdfs:domain cc:Host ; rdfs:range xsd:integer .
ccm:netIfaceDownCount a owl:DatatypeProperty ; rdfs:domain cc:Host ; rdfs:range xsd:integer .
ccm:netIfaceTotal a owl:DatatypeProperty ; rdfs:domain cc:Host ; rdfs:range xsd:integer .
ccm:replayLagBytesMax a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:integer .
ccm:replicationNotStreamingCount a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:integer .
ccm:alertActiveCount a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:integer .
ccm:indexCount a owl:DatatypeProperty ; rdfs:domain cc:Table ; rdfs:range xsd:integer .
ccm:unusedIndexCount a owl:DatatypeProperty ; rdfs:domain cc:Table ; rdfs:range xsd:integer .
ccm:replicationPendingBytes a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:integer .
ccm:replicationFlushPendingBytes a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:integer .
ccm:walsenderCount a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:integer .
ccm:replicationSlotCount a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:integer .
ccm:replicationSlotActiveCount a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:integer .
ccm:isStandby a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:boolean .
# ---- 应用层 / JdbcDataSource ----
ccm:activeConnections a owl:DatatypeProperty ; rdfs:domain cc:JdbcDataSource ; rdfs:range xsd:integer ;
    rdfs:comment "★ threshold_ref = JdbcDataSource.maxPoolSize（实体自带属性型绑定，值只从 cc:maxPoolSize 取）。"@zh .
ccm:idleConnections a owl:DatatypeProperty ; rdfs:domain cc:JdbcDataSource ; rdfs:range xsd:integer .
ccm:pendingThreads a owl:DatatypeProperty ; rdfs:domain cc:JdbcDataSource ; rdfs:range xsd:integer .
ccm:acquireWaitMs a owl:DatatypeProperty ; rdfs:domain cc:JdbcDataSource ; rdfs:range xsd:decimal .
ccm:connectLatencyMs a owl:DatatypeProperty ; rdfs:domain cc:JdbcDataSource ; rdfs:range xsd:decimal ;
    rdfs:comment "F5 vs F6 的区分器：立刻失败(认证) vs 超时(网络)。"@zh .
ccm:connectFailTotal a owl:DatatypeProperty ; rdfs:domain cc:JdbcDataSource ; rdfs:range xsd:integer .
ccm:timeoutTotal a owl:DatatypeProperty ; rdfs:domain cc:JdbcDataSource ; rdfs:range xsd:integer .
# ---- 承载层 / Container（+ 与 Host、GaussDBInstance 共享的 cpu_usage_ratio）----
ccm:cpuUsageRatio a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( cc:Container cc:Host cc:GaussDBInstance ) ] ;
    rdfs:range xsd:decimal ;
    rdfs:comment "★ 共享属性：container.cpu_usage_ratio / host.cpu_usage_ratio / db.instance.cpu_usage_ratio 三个指标码同形 ⇒ 一个属性 IRI + unionOf 域（3 个指标个体各自登记 object/layer）。"@zh .
ccm:cpuThrottledPeriods a owl:DatatypeProperty ; rdfs:domain cc:Container ; rdfs:range xsd:integer .
ccm:memWorkingSetMb a owl:DatatypeProperty ; rdfs:domain cc:Container ; rdfs:range xsd:integer ;
    rdfs:comment "★ threshold_ref = Container.memLimitMb（实体自带属性型绑定，因果边 E12 条件同源）。"@zh .
ccm:oomKillTotal a owl:DatatypeProperty ; rdfs:domain cc:Container ; rdfs:range xsd:integer .
ccm:restartTotal a owl:DatatypeProperty ; rdfs:domain cc:Container ; rdfs:range xsd:integer .
ccm:status a owl:DatatypeProperty ; rdfs:domain cc:Container ; rdfs:range xsd:string ;
    rdfs:comment "契约取 value 中：running | waiting | terminated（枚举强制在 SHACL ccs:ContainerShape）。"@zh .
# ---- 承载层 / Host ----
ccm:memAvailableRatio a owl:DatatypeProperty ; rdfs:domain cc:Host ; rdfs:range xsd:decimal .
ccm:load1 a owl:DatatypeProperty ; rdfs:domain cc:Host ; rdfs:range xsd:decimal ;
    rdfs:comment "契约无单位（unit: null）；阈值 load1_per_core_light 的 rationale 要求按 cc:cpuCores 归一化。"@zh .
ccm:load5 a owl:DatatypeProperty ; rdfs:domain cc:Host ; rdfs:range xsd:decimal .
ccm:diskUtil a owl:DatatypeProperty ; rdfs:domain cc:Host ; rdfs:range xsd:decimal .
ccm:diskIoWait a owl:DatatypeProperty ; rdfs:domain cc:Host ; rdfs:range xsd:decimal .
ccm:conntrackCount a owl:DatatypeProperty ; rdfs:domain cc:Host ; rdfs:range xsd:integer .
ccm:netRxBytes a owl:DatatypeProperty ; rdfs:domain cc:Host ; rdfs:range xsd:integer .
ccm:netTxBytes a owl:DatatypeProperty ; rdfs:domain cc:Host ; rdfs:range xsd:integer .
# ---- 数据层 / GaussDBCluster ----
ccm:upNodes a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:integer .
ccm:downNodes a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:integer .
ccm:replicationLagMb a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:decimal .
ccm:switchoverTotal a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:integer .
# ---- 数据层 / GaussDBInstance ----
ccm:memUsageRatio a owl:DatatypeProperty ; rdfs:domain cc:GaussDBInstance ; rdfs:range xsd:decimal .
ccm:sessionCount a owl:DatatypeProperty ; rdfs:domain cc:GaussDBInstance ; rdfs:range xsd:integer .
ccm:maxConnections a owl:DatatypeProperty ; rdfs:domain cc:GaussDBInstance ; rdfs:range xsd:integer ;
    rdfs:comment "实体自带配置值（不硬编码，沿用 onto-ops-agent D3 原则），db.pool.session_used_ratio 的分母。"@zh .
ccm:waitingConnections a owl:DatatypeProperty ; rdfs:domain cc:GaussDBInstance ; rdfs:range xsd:integer .
ccm:longTxnAgeS a owl:DatatypeProperty ; rdfs:domain cc:GaussDBInstance ; rdfs:range xsd:integer .
ccm:ioWaitPct a owl:DatatypeProperty ; rdfs:domain cc:GaussDBInstance ; rdfs:range xsd:decimal ;
    rdfs:comment "阈值审核清单实测生产值域 [0.22, 0.72]%，旧项目阈值写 >20 ⇒ 差 28 倍，永不命中（契约原始 note）。"@zh .
ccm:bufferHitRatio a owl:DatatypeProperty ; rdfs:domain cc:GaussDBInstance ; rdfs:range xsd:decimal .
ccm:up a owl:DatatypeProperty ; rdfs:domain cc:GaussDBInstance ; rdfs:range xsd:boolean ;
    rdfs:comment "F7 直接证据；规则里以 predicate is_false 判定（布尔状态谓词，不走阈值）。"@zh .
# ---- 数据层 / DatabaseSessionPool ----
ccm:sessionUsedRatio a owl:DatatypeProperty ; rdfs:domain cc:DatabaseSessionPool ; rdfs:range xsd:decimal ;
    rdfs:comment "契约表达式 db.instance.session_count / db.instance.max_connections（登记为 ccm:metricExpression）。"@zh .
ccm:sessionWaiting a owl:DatatypeProperty ; rdfs:domain cc:DatabaseSessionPool ; rdfs:range xsd:integer .
ccm:connRejectedTotal a owl:DatatypeProperty ; rdfs:domain cc:DatabaseSessionPool ; rdfs:range xsd:integer .
# ---- 数据层 / Session ----
ccm:state a owl:DatatypeProperty ; rdfs:domain cc:Session ; rdfs:range xsd:string ;
    rdfs:comment "契约取 value 中：active | idle | idle in transaction | waiting。"@zh .
ccm:waitEvent a owl:DatatypeProperty ; rdfs:domain cc:Session ; rdfs:range xsd:string ;
    rdfs:comment "契约取 value 中：LockMgrLock | transactionid | relation | tuple | WALWrite | DataFileRead。"@zh .
ccm:xactAgeS a owl:DatatypeProperty ; rdfs:domain cc:Session ; rdfs:range xsd:integer .
ccm:queryElapsedS a owl:DatatypeProperty ; rdfs:domain cc:Session ; rdfs:range xsd:decimal .
# ---- 数据层 / Query ----
ccm:meanExecMs a owl:DatatypeProperty ; rdfs:domain cc:Query ; rdfs:range xsd:decimal .
ccm:maxExecMs a owl:DatatypeProperty ; rdfs:domain cc:Query ; rdfs:range xsd:decimal .
ccm:execCount a owl:DatatypeProperty ; rdfs:domain cc:Query ; rdfs:range xsd:integer .
ccm:returnedRows a owl:DatatypeProperty ; rdfs:domain cc:Query ; rdfs:range xsd:integer .
ccm:seqScanRatio a owl:DatatypeProperty ; rdfs:domain cc:Query ; rdfs:range xsd:decimal .
# ---- 数据层 / Table ----
ccm:liveTuples a owl:DatatypeProperty ; rdfs:domain cc:Table ; rdfs:range xsd:integer .
ccm:deadTupleRatio a owl:DatatypeProperty ; rdfs:domain cc:Table ; rdfs:range xsd:decimal ;
    rdfs:comment "★ docs\\04 §6 的 r02 示例把它写进 FM-DB-SLOW-QUERY 判据，但 fault-modes.yaml 的 detect 里没有它（X-2）⇒ 本实现不作为规则条件。"@zh .
ccm:lastAnalyzeAgeH a owl:DatatypeProperty ; rdfs:domain cc:Table ; rdfs:range xsd:decimal .
ccm:sizeMb a owl:DatatypeProperty ; rdfs:domain cc:Table ; rdfs:range xsd:decimal .

# ★ P0-A（2026-10-12）：新增 12 个 DB 指标的数据属性
ccm:deadlocks a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:integer .
ccm:xactRollback a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:integer .
ccm:slowQueryCount a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:integer .
ccm:activeSessions a owl:DatatypeProperty ; rdfs:domain cc:GaussDBInstance ; rdfs:range xsd:integer .
ccm:idleInXact a owl:DatatypeProperty ; rdfs:domain cc:GaussDBInstance ; rdfs:range xsd:integer .
ccm:lockWaits a owl:DatatypeProperty ; rdfs:domain cc:GaussDBInstance ; rdfs:range xsd:integer .
ccm:tempFiles a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:integer .
ccm:tempFileWritten a owl:DatatypeProperty ; rdfs:domain cc:GaussDBCluster ; rdfs:range xsd:boolean .
ccm:seqScan a owl:DatatypeProperty ; rdfs:domain cc:Table ; rdfs:range xsd:integer .
ccm:idxScan a owl:DatatypeProperty ; rdfs:domain cc:Table ; rdfs:range xsd:integer .
ccm:deadTuples a owl:DatatypeProperty ; rdfs:domain cc:Table ; rdfs:range xsd:integer .
ccm:hotUpdateRatioPct a owl:DatatypeProperty ; rdfs:domain cc:Table ; rdfs:range xsd:decimal .

# ===========================================================================
# 4) 指标件元数据属性与阈值属性（对象属性 7 条 + 数据属性 13 条）
# ===========================================================================
ccm:metricProperty a owl:ObjectProperty ; rdfs:domain ccm:Metric ; rdfs:range owl:DatatypeProperty ;
    rdfs:label "指标属性"@zh ;
    rdfs:comment "指标件 → 承载观测值的数据属性（70 个指标 → 68 个属性 IRI：ccm:cpuUsageRatio 被 3 个指标码复用）。"@zh .
ccm:metricObjectType a owl:ObjectProperty ; rdfs:domain ccm:Metric ; rdfs:range owl:Class ;
    rdfs:label "指标适用类型"@zh ;
    rdfs:comment "取 metrics.yaml 的 object 字段，指向 cc: 类。"@zh .
ccm:hasThreshold a owl:ObjectProperty ; rdfs:domain ccm:Metric ; rdfs:range ccm:Threshold ;
    owl:inverseOf ccm:thresholdMetric ;
    rdfs:label "拥有阈值名"@zh .
ccm:thresholdMetric a owl:ObjectProperty ; rdfs:domain ccm:Threshold ; rdfs:range ccm:Metric ;
    rdfs:label "阈值所属指标"@zh .
ccm:warningTier a owl:ObjectProperty ; rdfs:domain ccm:Threshold ; rdfs:range ccm:WarningThreshold ;
    rdfs:label "warning 档位"@zh .
ccm:criticalTier a owl:ObjectProperty ; rdfs:domain ccm:Threshold ; rdfs:range ccm:CriticalThreshold ;
    rdfs:label "critical 档位"@zh .
ccm:tierOf a owl:ObjectProperty ; rdfs:domain ccm:Threshold ; rdfs:range ccm:Threshold ;
    rdfs:label "档位所属阈值名"@zh .

ccm:metricCode a owl:DatatypeProperty ; rdfs:domain ccm:Metric ; rdfs:range xsd:string ;
    rdfs:comment "逐字取自 metrics.yaml 的 code（可追溯到契约条目）。"@zh .
ccm:metricLayer a owl:DatatypeProperty ; rdfs:domain ccm:Metric ; rdfs:range xsd:string ;
    rdfs:comment "App | Runtime | Data（枚举强制在 SHACL ccs:MetricShape）。"@zh .
ccm:metricUnit a owl:DatatypeProperty ; rdfs:domain ccm:Metric ; rdfs:range xsd:string .
ccm:metricRangeMin a owl:DatatypeProperty ; rdfs:domain ccm:Metric ; rdfs:range xsd:decimal .
ccm:metricRangeMax a owl:DatatypeProperty ; rdfs:domain ccm:Metric ; rdfs:range xsd:decimal .
ccm:metricEnumValue a owl:DatatypeProperty ; rdfs:domain ccm:Metric ; rdfs:range xsd:string .
ccm:metricExpression a owl:DatatypeProperty ; rdfs:domain ccm:Metric ; rdfs:range xsd:string .
ccm:metricNote a owl:DatatypeProperty ; rdfs:domain ccm:Metric ; rdfs:range xsd:string .
ccm:thresholdName a owl:DatatypeProperty ; rdfs:domain ccm:Threshold ; rdfs:range xsd:string .
ccm:thresholdValue a owl:DatatypeProperty ; rdfs:domain ccm:Threshold ; rdfs:range xsd:decimal ;
    rdfs:comment "★ 只在**本体侧**出现数值：规则（rules/*.rq）一律通过 ccm:tierReference 引用，绝不内联数字。"@zh .
ccm:tierReference a owl:DatatypeProperty ; rdfs:domain ccm:Threshold ; rdfs:range xsd:string ;
    rdfs:comment "★ 契约引用键，形如 threshold:<阈值名>#<warning|critical>（档位必填）。规则用 VALUES 绑定它。"@zh .
ccm:uncalibrated a owl:DatatypeProperty ; rdfs:domain ccm:Threshold ; rdfs:range xsd:boolean ;
    rdfs:comment "true = 契约里该档 warning/critical 为 null（未标定）⇒ 依赖它的规则真机必产 0 条，属标定缺口而非实现缺陷。"@zh .
ccm:rationale a owl:DatatypeProperty ; rdfs:domain ccm:Threshold ; rdfs:range xsd:string ;
    rdfs:comment "threshold_policy.required_fields 之一（rationale 必填）。"@zh .

