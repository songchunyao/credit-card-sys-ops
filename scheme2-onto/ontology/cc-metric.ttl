    ccm:metricObjectType cc:Query ; ccm:metricLayer "Data" ; ccm:metricUnit "次" .
ccm:m_db_query_returned_rows a ccm:Metric ; ccm:metricCode "db.query.returned_rows" ; cco:metricCode "db.query.returned_rows" ; ccm:metricProperty ccm:returnedRows ;
    ccm:metricObjectType cc:Query ; ccm:metricLayer "Data" ; ccm:metricUnit "行" .
