ccm:m_db_table_live_tuples a ccm:Metric ; ccm:metricCode "db.table.live_tuples" ; cco:metricCode "db.table.live_tuples" ; ccm:metricProperty ccm:liveTuples ;
    ccm:metricObjectType cc:Table ; ccm:metricLayer "Data" ; ccm:metricUnit "行" .
ccm:m_db_table_dead_tuple_ratio a ccm:Metric ; ccm:metricCode "db.table.dead_tuple_ratio" ; cco:metricCode "db.table.dead_tuple_ratio" ;
    ccm:metricProperty ccm:deadTupleRatio ; ccm:metricObjectType cc:Table ; ccm:metricLayer "Data" ;
    ccm:metricUnit "ratio" ; ccm:metricRangeMin 0 ; ccm:metricRangeMax 1 ;
    ccm:metricNote "docs\\04 §6 r02 示例把它写进慢查询判据，但 fault-modes.yaml 的 detect 无此项（X-2）⇒ 规则不使用它"@zh .
ccm:m_db_table_last_analyze_age_h a ccm:Metric ; ccm:metricCode "db.table.last_analyze_age_h" ; cco:metricCode "db.table.last_analyze_age_h" ;
    ccm:metricProperty ccm:lastAnalyzeAgeH ; ccm:metricObjectType cc:Table ; ccm:metricLayer "Data" ;
    ccm:metricUnit "h" .
ccm:m_db_table_size_mb a ccm:Metric ; ccm:metricCode "db.table.size_mb" ; cco:metricCode "db.table.size_mb" ; ccm:metricProperty ccm:sizeMb ;
    ccm:metricObjectType cc:Table ; ccm:metricLayer "Data" ; ccm:metricUnit "MB" .

