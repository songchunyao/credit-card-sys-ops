    ccm:metricObjectType cc:Query ; ccm:metricLayer "Data" ; ccm:metricUnit "ms" ;
    ccm:metricNote "实测样本：慢 SQL 平均 30.8s、TOP 51.9s（来自 upstream-eval 真实用例）"@zh ;
    ccm:hasThreshold ccm:t_mean_exec_ms_light .
ccm:m_db_query_max_exec_ms a ccm:Metric ; ccm:metricCode "db.query.max_exec_ms" ; cco:metricCode "db.query.max_exec_ms" ; ccm:metricProperty ccm:maxExecMs ;
    ccm:metricObjectType cc:Query ; ccm:metricLayer "Data" ; ccm:metricUnit "ms" .
