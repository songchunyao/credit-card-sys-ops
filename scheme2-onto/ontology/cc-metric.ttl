ccm:m_db_cluster_xact_rollback a ccm:Metric ; ccm:metricCode "db.cluster.xact_rollback" ; cco:metricCode "db.cluster.xact_rollback" ; ccm:metricProperty ccm:xactRollback ;
    ccm:metricObjectType cc:GaussDBCluster ; ccm:metricLayer "Data" ; ccm:metricUnit "次" .
ccm:m_db_cluster_slow_query_count a ccm:Metric ; ccm:metricCode "db.cluster.slow_query_count" ; cco:metricCode "db.cluster.slow_query_count" ; ccm:metricProperty ccm:slowQueryCount ;
    ccm:metricObjectType cc:GaussDBCluster ; ccm:metricLayer "Data" ; ccm:metricUnit "次" .
