# 相关（非因果）断言：E16/E17 的二元视图（不参与收敛；环检测只看 ccc:cause）
ccf:FM-DB-SLOW-QUERY     ccc:relatesTo ccf:FM-DB-LOCK-WAIT .
ccf:FM-APP-HEAP-PRESSURE ccc:relatesTo ccf:FM-HOST-MEM-PRESSURE .

# ★ 27 条因果边两两不同（OWL 原生公理；方案1 的 LPG 只能在代码里断言）
[ a owl:AllDifferent ; owl:distinctMembers (
    ccc:E1 ccc:E2 ccc:E3 ccc:E4 ccc:E5 ccc:E6 ccc:E7 ccc:E8 ccc:E9 ccc:E10
    ccc:E11 ccc:E12 ccc:E13 ccc:E14 ccc:E15 ccc:E16 ccc:E17 ccc:E18
    ccc:E19 ccc:E20 ccc:E21 ccc:E22 ccc:E23 ccc:E24 ccc:E25 ccc:E26 ccc:E27 ) ] .

# ★ 一条边恰好一个因、一个果（OWL 原生基数公理；SHACL 侧另有必填校验）
ccc:cause  a owl:FunctionalProperty .
ccc:effect a owl:FunctionalProperty .

# ===========================================================================
# 8) 3 组区分器（契约 discriminators；靠「某指标正常」定罪 = 否定性证据）
# ===========================================================================
ccc:D1 a ccc:Discriminator ;
    ccc:discriminates ccf:FM-APP-POOL-EXHAUSTED , ccf:FM-DB-SESSION-POOL-FULL ;
    ccc:discriminatorMetric ccm:m_db_pool_session_used_ratio ;
    ccc:symptomShared "应用连接获取失败" ;
    ccc:discriminatorRule "数据库侧正常 → 应用侧；数据库侧贴顶 → 数据库侧" ;
    ccc:discriminatorNote "★ 靠「某指标正常」定罪 —— 否定性证据" ;
    ccc:chainCode "F2" ;
    cco:contractSource "causal-edges.yaml#/discriminators[pair=FM-APP-POOL-EXHAUSTED|FM-DB-SESSION-POOL-FULL]" ;
    rdfs:label "区分器：应用侧连接池耗尽 vs 数据库会话池耗尽"@zh .
ccc:D2 a ccc:Discriminator ;
    ccc:discriminates ccf:FM-CTR-NET-UNREACHABLE , ccf:FM-APP-AUTH-INCOMPATIBLE ;
    ccc:discriminatorMetric ccm:m_app_datasource_connect_latency_ms ;
    ccc:symptomShared "应用连不上数据库" ;
    ccc:discriminatorRule "超时（达 connectionTimeoutMs）→ 网络；立即失败 → 认证/协议" ;
    ccc:chainCode "F5" , "F6" ;
    cco:contractSource "causal-edges.yaml#/discriminators[pair=FM-CTR-NET-UNREACHABLE|FM-APP-AUTH-INCOMPATIBLE]" ;
    rdfs:label "区分器：容器网络不可达 vs JDBC 认证不兼容"@zh .
ccc:D3 a ccc:Discriminator ;
    ccc:discriminates ccf:FM-HOST-MEM-PRESSURE , ccf:FM-APP-HEAP-PRESSURE ;
    ccc:discriminatorMetric ccm:m_host_mem_available_ratio ;
    ccc:symptomShared "容器 OOM 被杀" ;
    ccc:discriminatorRule "宿主机内存紧张 → E9 路径；宿主机正常但容器 limit 小 → E12 路径" ;
    ccc:chainCode "F4" ;
    cco:contractSource "causal-edges.yaml#/discriminators[pair=FM-HOST-MEM-PRESSURE|FM-APP-HEAP-PRESSURE]" ;
    rdfs:label "区分器：宿主机内存紧张 vs 应用堆压力"@zh .

# ===========================================================================
# 9) 契约元数据固化（环白名单 / 传递性开关）
# ===========================================================================
# 契约 meta.cycles 白名单唯一项 [FM-APP-POOL-EXHAUSTED, FM-APP-ENDPOINT-SLOW]，
# 对应 E5(E5: POOL→ENDPOINT) + E6(E6: ENDPOINT→POOL) 这一对；E6 为条件边。
# T6 用 SPARQL 属性路径 ccc:cause{2,4} 自反检测环，检出集合必须 ⊆ 本白名单。
# 契约 meta.transitive = false ⇒ 本体**不**声明 ccc:cause 的 owl:TransitiveProperty
# 属性特征（只约束推理与语料生成；不阻碍有界属性路径的环检测）。
[ a owl:AllDifferent ; owl:distinctMembers ( ccc:prov-E1 ccc:prov-E2 ccc:prov-E3 ccc:prov-E4 ccc:prov-E5
  ccc:prov-E6 ccc:prov-E7 ccc:prov-E8 ccc:prov-E9 ccc:prov-E10 ccc:prov-E11 ccc:prov-E12 ccc:prov-E13
  ccc:prov-E14 ccc:prov-E15 ccc:prov-E16 ccc:prov-E17 ccc:prov-E18
  ccc:prov-E19 ccc:prov-E20 ccc:prov-E21 ccc:prov-E22
  ccc:prov-E23 ccc:prov-E24 ccc:prov-E25 ccc:prov-E26 ccc:prov-E27 ) ] .

# ===========================================================================
# 10) 契约偏差登记
# ===========================================================================
# X-3  docs/04 §4.5 草案把阈值内联为 ccc:condValue "0.9"^^xsd:decimal；本模块统一
#      改为引用式（ccc:condThreshold → ccm:Threshold 档位个体 + ccc:condTier 档位名），
#      条件个体里**零内联数值**。
# X-4  docs/04 §4.5 把 `ccc:CausalLink-E7 a owl:Class` 写成类；本模块正确地声明
#      `ccc:CausalLink a owl:Class`，E7 是它的个体 ccc:E7。
# X-8  docs/04 §8 T4 要求「ccc:provenance 的 IRI ∈ 契约」，但 causal-edges.yaml 的
#      provenance 字段值是字面量 "authored"，契约内**无任何 IRI** ⇒ 本模块把出处
#      物化为 ccc:ContractProvenance 个体（ccc:prov-E1..E27，IRI 由契约
#      provenance + edges[].id 确定性派生），并在个体上保留 provenanceToken 原文。
# 契约缺口  meta.cycles 已登记唯一有向环，但契约**没有**给出「哪些边可条件性成环」
#      之外的深度上界；G8（因果深度 ≤4）属 cc_query 护栏，本体不表达。