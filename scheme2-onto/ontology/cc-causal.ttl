    ccc:condThresholdReference "threshold:mem_available_ratio_severe#critical" ; ccc:condThreshold ccm:t_mem_available_ratio_severe_critical ;
    cco:contractSource "causal-edges.yaml#/edges[id=E9]/condition" .
ccc:Cond-E12 a ccc:Condition ;
