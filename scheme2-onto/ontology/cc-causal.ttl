    ccc:condOp ">" ; ccc:condOperand "threshold:cpu_usage_ratio_severe#critical" ; ccc:condTier "critical" ;
    ccc:condThresholdReference "threshold:cpu_usage_ratio_severe#critical" ; ccc:condThreshold ccm:t_cpu_usage_ratio_severe_critical ;
    cco:contractSource "causal-edges.yaml#/edges[id=E7]/condition" .
