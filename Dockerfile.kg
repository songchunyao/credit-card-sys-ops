# ═══════════════════════════════════════════════════════════════════════════
#  Dockerfile.kg —— 方案1 知识服务（KG-Q，Neo4j + Cypher）:8301
# ═══════════════════════════════════════════════════════════════════════════
#  内容：scheme1-kg/service/cc_tools.py（Set B 八工具，只读）+ 契约层 shared/
#  载体：Neo4j 5-community，**走 HTTP**（:7475），故**不需要** neo4j 驱动
#        —— 见方案梳理报告 §4.4「依赖面：只用 requests + 标准库 + fastapi」
#
#  构建（构建上下文 = 仓库根）：
#      docker build -f Dockerfile.kg -t cc-ops/kg:<tag> .
#
#  ★ 布局是运行期契约，不得拍平：
#      cc_tools.py:2753 repo_root_default() 从自身位置上溯，找含
#      `shared/model/tools-setb.yaml` 的目录当作仓库根；编排放**必须**保持
#      /app/scheme1-kg/service/cc_tools.py 与 /app/shared/model/... 的相对关系。
#  ★ 镜像内零密钥：Neo4j 口令由运行时 CC_NEO4J_PASSWORD 注入。
# ═══════════════════════════════════════════════════════════════════════════

FROM python:3.12-slim AS builder

ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_TRUSTED_HOST=mirrors.aliyun.com
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST} \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# ★ 版本钉死（与本项目 ci/Dockerfile 同一组实测可用的版本，避免"今天绿明天红"）
WORKDIR /build
RUN pip install --no-cache-dir --prefix=/install \
        "fastapi==0.136.3" \
        "pydantic==2.13.4" \
        "uvicorn==0.49.0" \
        "starlette==1.2.1" \
        "requests==2.34.2" \
        "PyYAML==6.0.3"


FROM python:3.12-slim

# ★ ARG 不跨 build stage，必须重新声明（否则 sed 把源改成 http:///debian 且静默装不上）
ARG APT_MIRROR=mirrors.ustc.edu.cn

LABEL org.opencontainers.image.title="CC-Ops KG Knowledge Service" \
      org.opencontainers.image.description="信用卡跨层运维 · 方案1 知识服务（KG-Q :8301）" \
      org.opencontainers.image.source="https://github.com/songchunyao/credit-card-sys-ops"

RUN sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list /etc/apt/sources.list.d/*.sources 2>/dev/null || true \
    && if grep -rqs "deb.debian.org" /etc/apt/sources.list /etc/apt/sources.list.d/ ; then \
         echo "错误：apt 换源未生效（APT_MIRROR='${APT_MIRROR}'），拒绝继续构建"; exit 1; \
       fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl tini ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local

# ── 应用树（保持仓库相对布局）──
WORKDIR /app
COPY shared/      /app/shared/
COPY scheme1-kg/  /app/scheme1-kg/

# ── 构建期闭包断言 ──────────────────────────────────────────────────────────
# 「布局即契约」不能只写在注释里：缺件时应当**构建就失败**，而不是推到运行期。
#   cc_tools.py:2753 repo_root_default() 靠上溯找 shared/model/tools-setb.yaml
#   来判定仓库根 ⇒ 该文件既是"数据"也是**定位锚点**，缺了会让仓库根算错。
#   mapping/ 与 targets.yaml 是命名与拓扑契约，工具面与溯源都依赖它们。
RUN set -e; \
    for f in \
      scheme1-kg/service/cc_tools.py \
      shared/model/tools-setb.yaml \
      shared/model/topology.yaml \
      shared/model/metrics.yaml \
      shared/model/fault-modes.yaml \
      shared/model/causal-edges.yaml \
      shared/mapping/type-map.yaml \
      shared/mapping/rel-map.yaml \
      shared/deploy/targets.yaml ; do \
      if [ ! -f "/app/$f" ]; then echo "错误：布局契约缺件 /app/$f"; exit 1; fi; \
    done; \
    echo "布局契约齐备（9 件）"

# 审计链落盘目录（R-27：追加式 JSONL，重启后继续追加 ⇒ 由 compose 挂卷持久化）
RUN find /app -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true \
    && mkdir -p /var/lib/cc-ops/audit \
    && groupadd -g 10001 cco && useradd -u 10001 -g cco -m -s /bin/bash cco \
    && chown -R cco:cco /app /var/lib/cc-ops
USER cco

ENV CC_TOOLS_HOST=0.0.0.0 \
    CC_TOOLS_PORT=8301 \
    CC_AUDIT_LOG=/var/lib/cc-ops/audit/cc_tools_audit.jsonl \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

EXPOSE 8301

HEALTHCHECK --interval=30s --timeout=6s --start-period=20s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:8301/health" >/dev/null || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "scheme1-kg/service/cc_tools.py", "--serve", "--host", "0.0.0.0", "--port", "8301"]
