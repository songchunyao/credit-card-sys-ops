[Unit]
Description=cc-tools KG-T 门面 (:8303)
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=30

[Service]
Type=forking
Environment=CC_KGT_DIR=/opt/cc-tools-kg/kgt
PIDFile=/opt/cc-tools-kg/kgt/cc_tools_kgt.pid
WorkingDirectory=/opt/cc-tools-kg/kgt/scheme1-kg/service
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do (exec 3<>/dev/tcp/127.0.0.1/7688) 2>/dev/null && exit 0; sleep 5; done; echo "Neo4j :7688 未在 300s 内就绪" >&2; exit 1'
ExecStart=/bin/bash -c 'cd /opt/cc-tools-kg/kgt/scheme1-kg/service && exec bash start_cc_tools_kgt.sh'
Restart=on-failure
RestartSec=15
TimeoutStartSec=360

[Install]
WantedBy=multi-user.target
