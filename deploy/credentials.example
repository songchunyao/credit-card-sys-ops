# =============================================================================
# deploy/credentials.example —— 凭据填单（**整台部署只需要填这一份**）
#
# 用法
# ----
#   1) cp deploy/credentials.example deploy/credentials
#   2) 逐项填入你的环境的值；拿不到的留空（留空 ≠ 填错，见下面的"三级判定"）
#   3) 合并进部署配置并校验：
#        python3 deploy/credentials_check.py --sheet deploy/credentials \
#                --base http://127.0.0.1 --merge-into deploy/.env
#
# ★★ 安全约定 ★★
#   · 本文件（credentials.example）**不含任何真实口令**，可以入库；
#     你填好的 `deploy/credentials` 已被 .gitignore 覆盖，**永不入库**
#     —— 同理它也**不会被打进离线发布包**（打包脚本会删除并断言）。
#   · 校验器**只打印"是否可用 / 掩码"，不打印口令本体，也不登记长度或首尾字符**
#     （长度 + 少量字符足以缩小暴力搜索空间）。
#   · 取值优先级：本填单 > 环境变量 > 本地 .env。
#     凭据若已配在你的 CI/CD 里，流水线会把它注入为环境变量，这里留空即可。
#
# 三级判定（校验器与验收矩阵共用这套语义）
#   ✅ 已提供且实测可用 ／ ⚠️ 已提供但未能确认（例如缺工具、对端不配合）
#   ⛔ 未提供（会点名卡住哪一项验收）／ ✗ 已提供但实测失败
#   ★ **BLOCKED（未测到）不是 FAIL（测得坏）**——留空不会让验收"变红"，只会让它"测不了"。
#
# 格式：`KEY=值`，`#` 开头是注释。留空 = 不提供。
# 下文示例中的地址一律用文档保留段（192.0.2.0/24），请替换为你的真实地址。
# =============================================================================


# =============================================================================
# 一、采集层（:8187）—— 被观测对象
# =============================================================================

# ── 1.1 GaussDB 主节点 DSN ★★ 最需要你提供的一项 ★★ ─────────────────────────
# 用途：采集层连 GaussDB 做采集 / EXPLAIN / 表统计（数据层事实的唯一来源）
# 格式：host=<IP> port=<端口> dbname=<库> user=<用户> password=<口令>
# 缺失后果：验收矩阵「GaussDB 可达」判 BLOCKED、真实采集为 0 条、`db.*` 域事实全空
#           —— 这不是"测坏了"，是"没得测"。
# 建议：给一个**只读**账号（本项目只读，不会写你的库）。
GAUSSDB_DSN=

# ── 1.2 集群拓扑 ────────────────────────────────────────────────────────────
# 用途：OS 探针要 ssh 到每个节点；也是拓扑展示的来源
# 格式：逗号分隔的 IP（也接受 host:port:node_id:node_type:alias 的完整写法）
# 例：192.0.2.13,192.0.2.14,192.0.2.15
GAUSSDB_NODES=
GAUSSDB_CLUSTER_ID=

# ── 1.3 OS 探针 SSH（os 层事实）─────────────────────────────────────────────
# 用途：os 探针走 sshpass 子进程登各节点（口令模式）
# ★ 用密钥模式则走下面的密钥路径，口令留空
GAUSSDB_SSH_USER=
GAUSSDB_SSH_PORT=
GAUSSDB_SSH_PASSWORD=

# ── 1.4 存储域：OceanStor Dorado DeviceManager（storage 层事实）──────────────
# 用途：storage 探针查存储池 / 控制器 / 告警
# ⚠ 键名是 MCP_STORAGE_DM_*，**不是** DORADO_*（旧写法不生效）
MCP_STORAGE_DM_BASE_URL=
MCP_STORAGE_DM_USER=
MCP_STORAGE_DM_PASSWORD=
MCP_STORAGE_DM_VERIFY_SSL=

# ── 1.5 TPOPS 平台（tpops 层事实）───────────────────────────────────────────
# ⚠ 键名必须是 TPOPS_BASE（代码读这个；TPOPS_API_BASE 是漂移写法，写了也不生效）
# 例：https://192.0.2.16:8002
TPOPS_BASE=
TPOPS_USER=
TPOPS_PASSWORD=

# ── 1.6 L1 被测应用 / L2 容器载体 / 日志检索 ────────────────────────────────
# 用途：app 探针只读 GET /health；container 探针读 Prometheus；search_logs 查 ES
# 例：http://192.0.2.12:30085
CC_APP_URL=
CC_APP_TIMEOUT=
K8S_PROM_URL=
K8S_PROM_TIMEOUT=
CC_APP_NAMESPACE=cc-app
CC_APP_POD=
K8S_ES_HOST=


# =============================================================================
# 二、知识载体
# =============================================================================

# ── 2.1 Neo4j（KG 侧）────────────────────────────────────────────────────────
# 用途：方案1（KG-Q :8301）与方案3（KG-T :8303 / 补充臂 :8305）读写图
# 缺失后果：这些服务完全不可用（全部 fail-closed，绝不回落默认口令）
# ★ 口令长度/形态/首尾字符一律不登记
CC_NEO4J_USER=
CC_NEO4J_PASSWORD=
# attached 档用（指向既有载体）；standalone 档会自动改写为容器内地址
CC_NEO4J_HTTP_URL=
CC_NEO4J_URI=

# ── 2.2 GraphDB（ONTO 侧）────────────────────────────────────────────────────
# 【多数情况无需凭据】GraphDB 常见配置是 auth_type=none（security_enabled=false）
# 只有当你把目标换成"启用了认证"的 GraphDB 时才需要填下面两项
CC_GRAPHDB_URL=
CC_GRAPHDB_REPOSITORY=
CC_GRAPHDB_USER=
CC_GRAPHDB_PASSWORD=


# =============================================================================
# 三、编排层（Dify）
# =============================================================================

# 用途：把工具注册进 Dify、部署各方案 Agent；
#       standalone 档自动安装 Dify 时也用它做**首次管理员初始化**
# 缺失后果：注册/部署类作业判 BLOCKED（不是失败）
DIFY_BASE_URL=
DIFY_EMAIL=
DIFY_PASSWORD=
# 【自动回填】首次注册工具/Agent 后由脚本写回，一般不用手填
DIFY_WORKSPACE_ID=
DIFY_APP_ID=
# 【需你确认】Dify 自述的对外地址（生成控制台链接用）。
#   standalone 档自动安装时若填了它，会把 CONSOLE_API_URL 等一并改写；
#   留空 = 仅本机直连可用。
#   例：192.0.2.10
CC_DIFY_PUBLIC_HOST=


# =============================================================================
# 四、远端运维通道（全部可选 —— 只在"把服务部署到别的机器"时才需要）
# =============================================================================

# ── 4.1 目标机 SSH（可选）──────────────────────────────────────────────────
# 用途：把发布包推到目标机、在目标机上安装与排障。
#   若本机就是目标机（自包含同机部署），这一组留空即可。
#   例：192.0.2.11
CC_SSH_HOST=
CC_SSH_USER=
CC_SSH_PORT=
CC_SSH_PASSWORD=

# ── 4.2 交付流水线用的变量（可选，若要跑 CI 交付作业）──────────────────────
# 用途：交付作业把离线包推到目标机并安装。
#   该作业是 **fail-closed**：变量缺失即 `exit 2`（BLOCKED），不会伪装成功。
#   设置方式：在你的 CI 平台里把下面几项加成 **Masked** 变量——
#   注意是按"环境变量"注入，本校验器读环境变量，不需要额外的 token 文件。
VALIDATE_SSH_HOST=
VALIDATE_SSH_USER=
VALIDATE_SSH_PASSWORD=
# 【可选】目标机落地目录与档位
CC_DEPLOY_REMOTE_DIR=
CC_DEPLOY_TARGET_MODE=

# ── 4.3 洁净环境演练靶机（可选）────────────────────────────────────────────
# 用途：在没装过任何东西的机器上走一遍完整交付 —— 最有说服力的验收方式
RANGE_SSH_HOST=
RANGE_SSH_USER=
RANGE_SSH_PASSWORD=


# =============================================================================
# 五、**不需要**你提供的（列在这里免得你去找）
# =============================================================================
# · 镜像仓库凭据：本项目的 5 个应用镜像都由本仓 Dockerfile 构建，基础镜像取自公开仓库
# · 邮件/SMTP：编排层的通知功能在本项目里未启用
# · 域名/证书：默认按 IP + HTTP 直连部署计划；要上 HTTPS 请自备证书
# · 只读观测：采集层与工具面**只读**你的库/存储，不需要写权限账号
