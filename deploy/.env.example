# =============================================================================
# deploy/.env.example —— credit-card-sys-ops 容器化部署 · 全键配置模板
#
# 用法：
#     cp deploy/.env.example deploy/.env && vi deploy/.env
#
# ★★ 四条硬约定 ★★
#   1. **必须放在 deploy/ 目录下、必须叫 .env**：compose 只用 **compose 文件同目录**
#      的 .env 做 ${VAR} 插值；放错位置不报错，所有 ${VAR} 会**静默**走默认值。
#   2. 本文件**只列键名与说明，不含任何真实口令**；填充后的 deploy/.env 已被
#      .gitignore 覆盖，**永不入库**。
#   3. compose **刻意不用 `env_file:`** —— 那会把整份 .env 无差别塞进每个容器。
#      各服务只拿到自己需要的那几个键（见 compose.yml 各服务的 environment 白名单）。
#   4. 采集层的键名以「代码实测」为准（下方标注了读取位置）。照抄旧的
#      dist/collect-layer/.env.example 会踩坑：它写的 `DORADO_*` 在代码里
#      **根本不存在**，代码读的是 `MCP_STORAGE_DM_*` ⇒ 键名写错不报错、只静默采空。
#      `deploy/selfcheck.py` 会断言本文件的键覆盖代码实际读取的全部变量。
#
# 密级标注：【密】= 凭据，绝不入库；【配】= 环境相关配置；【调】= 可选调优
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 0. 部署控制（由 install.sh / preflight / deps 读取，不进入容器）
# ─────────────────────────────────────────────────────────────────────────────

# 镜像标签。从离线包安装时 install.sh 会用包内 VERSION 的值覆盖它
CC_IMAGE_TAG=latest

# 拓扑档：attached=复用既有 Neo4j/GraphDB（192.0.2.10 现网必须用这档）
#         standalone=自带 Neo4j + GraphDB（任意新服务器）
# 【配】install.sh 的 --mode 会覆盖本值
CC_DEPLOY_MODE=attached

# 服务监听绑定地址。默认全网卡；只想本机访问就设 127.0.0.1
# 【配】:8304 必须容器可达（Dify 从宿主外访问），一般保持 0.0.0.0
CC_BIND_IP=0.0.0.0

# ★ R-58：不硬编码部署主机（原值为 192.0.2.10，R-56 事故根因）；用 env/CLI 覆盖，未设则落本机。
# 【配】部署主机（Dify 控制台 / SSH / smoke 的宿主地址）。留空 = 落本机 127.0.0.1
#   消费方：shared/deploy/dify/plugin_bind.py（PROD_HOST）、shared/deploy/smoke/e2e_smoke.py（HOST）
CC_DEPLOY_HOST=

# 外部依赖策略：check=只体检并报告；install=缺失则从官方镜像源自动安装
CC_DEPS_MODE=install

# 【调】preflight 的硬门槛（不达标即拒绝继续）
CC_MIN_DISK_GB=20
CC_MIN_MEM_MB=7000
# 【调】等待 5 个应用服务健康的总超时（秒）
CC_HEALTH_TIMEOUT_S=180

# 【配】可选：OS 探针走密钥模式时的私钥目录（口令模式留空即可，空目录无害）
CC_SSH_DIR=./secrets/ssh


# ─────────────────────────────────────────────────────────────────────────────
# 1. 知识载体 · KG 侧（Neo4j 5-community）
#    attached 档 → 指向既有 neo4j-gaussdb（宿主 7475/7688）
#    standalone 档 → compose 叠加文件改写为容器内 http://neo4j:7474
# ─────────────────────────────────────────────────────────────────────────────

# 【配】Neo4j HTTP 端点。**注意端口与惯例不符**：契约 7475（非 7474）、bolt 7688（非 7687）
CC_NEO4J_HTTP_URL=http://host.docker.internal:7475
# 【配】Bolt 端点；方案3（KG-T :8303）的 topology_reader 与契约装载用
CC_NEO4J_URI=bolt://host.docker.internal:7688
# 【配】用户名与库名（community 版单库）
CC_NEO4J_USER=neo4j
CC_NEO4J_DATABASE=neo4j
# 【密】口令。attached 档可留空，改由 CC_NEO4J_ENV_FILE 解析；
#       standalone 档**必填**（缺它起栈即失败，不会静默起一个免密图库）
CC_NEO4J_PASSWORD=
# 【配】口令兜底来源（宿主上的 .env 文件，含 `NEO4J_AUTH=user/pass`）
CC_NEO4J_ENV_FILE=/opt/upstream-agent/.env
# 【配】standalone 档专用：镜像与内存预算（与现网 neo4j-gaussdb 同量级）
CC_NEO4J_IMAGE=neo4j:5-community
CC_NEO4J_HEAP=1G
CC_NEO4J_PAGECACHE=512m


# ─────────────────────────────────────────────────────────────────────────────
# 2. 知识载体 · ONTO 侧（GraphDB 10.8.0）
# ─────────────────────────────────────────────────────────────────────────────

# 【配】GraphDB 端点。attached → 宿主 7200；standalone → http://graphdb:7200
CC_GRAPHDB_URL=http://host.docker.internal:7200
# 【配】项目专属仓库名（与既有 gdo* / starwars 仓库隔离）
CC_GRAPHDB_REPOSITORY=cc-ops
# 【调】留空 = 自动解析最新快照图
CC_GRAPHDB_SNAPSHOT_ID=
# 【调】TBox 命名图 IRI；留空 = 用 type-map.yaml 的 namespaces.onto.base + graph/tbox
CC_GRAPHDB_TBOX_GRAPH=
# 【密】目标 GraphDB 实测 auth_type=none，默认无需凭据；启用认证时再填
CC_GRAPHDB_USER=
CC_GRAPHDB_PASSWORD=
# 【配】standalone 档专用：镜像与 JVM 预算
CC_GRAPHDB_IMAGE=ontotext/graphdb:10.8.0
CC_GRAPHDB_HEAP=4g
CC_GRAPHDB_JAVA_OPTS=


# ─────────────────────────────────────────────────────────────────────────────
# 3. 采集层（:8187）—— 被观测对象
#    ★ 键名逐字取自代码实测，读取位置已标注
# ─────────────────────────────────────────────────────────────────────────────

# ── 3.1 GaussDB 集群（L3）──────────────────────────────────────────────────
# 【配·必填】主节点 DSN（采集/EXPLAIN/表统计走此节点）
#   格式：host=IP port=PORT dbname=DB user=USER password=PASS
GAUSSDB_DSN=
# 【配·必填】集群全部 DN 拓扑，逗号分隔
#   格式：host:port:node_id:node_type:alias
GAUSSDB_NODES=
# 【配】集群标识（拓扑健康展示用）
GAUSSDB_CLUSTER_ID=
# 【调】OS 探针错误检查点（断点续采）
OS_ERR_CHECKPOINT=
# 【调】GaussDB 探针的 delta 状态/断点文件（**容器内**路径，须可写）
#   ★ 写代码自己的默认值，**不要留空串**：gaussdb_probe.py 用
#     `os.environ.get("CC_GDB_PROBE_STATE", "/tmp/cc-gaussdb-probe-state.json")`
#     —— 键「存在但为空串」时会取到 ""（与上面 GAUSSDB_SSH_MUX_PERSIST 同一类坑）。
CC_GDB_PROBE_STATE=/tmp/cc-gaussdb-probe-state.json

# ── 3.2 OS 探针 SSH（os_probe.py）─────────────────────────────────────────
# 【配】SSH 账号/端口
GAUSSDB_SSH_USER=root
GAUSSDB_SSH_PORT=22
# 【密】口令模式（探针走 sshpass 子进程）。与下面的密钥模式二选一
GAUSSDB_SSH_PASSWORD=
# 【配】密钥模式：容器内路径（需配合 CC_SSH_DIR 的挂载）
GAUSSDB_SSH_KEY=
# 【调】ControlMaster 连接复用：实测单命令均值 3.97s → 0.16s（≈25×）
# ★★ 绝不能留空串（2026-10-12 实测事故）：os_probe.py 用
#   `os.environ.get("GAUSSDB_SSH_MUX_PERSIST", "60")` 取默认值，而
#   `os.environ.get(K, default)` 只在键**不存在**时生效 —— 键存在且为空串时取到 ""，
#   拼出 `-o ControlPersist=`（空参数）⇒ ssh 报 `no argument after keyword
#   "controlpersist"` ⇒ **os 层每条 SSH 命令全部失败**（87 条告警、os 事实 117→15，
#   连带 host.cpu_usage_ratio/load1/mem_available_ratio 等覆盖门禁指标全缺）。
#   ⇒ 写成代码自己的默认值。MUX_DIR 留空安全（代码内 `_MUX_DIR or <tmp>/gdo-ssh-mux` 回落）。
GAUSSDB_SSH_MUX=1
GAUSSDB_SSH_MUX_DIR=
GAUSSDB_SSH_MUX_PERSIST=60

# ── 3.3 存储域：OceanStor Dorado DeviceManager ────────────────────────────
# ★★ 键名是 MCP_STORAGE_DM_*，**不是** DORADO_* ★★
# 【配】如 https://192.0.2.x:8088
MCP_STORAGE_DM_BASE_URL=
# 【密】
MCP_STORAGE_DM_USER=
MCP_STORAGE_DM_PASSWORD=
# 【调】自签证书环境设 false
MCP_STORAGE_DM_VERIFY_SSL=

# ── 3.4 TPOPS 平台（tpops_probe.py）───────────────────────────────────────
# 【配】
TPOPS_BASE=
# 【密】
TPOPS_USER=
TPOPS_PASSWORD=

# ── 3.5 L1/L2 被测载体（2026-10-12 重写为**裸 docker 容器**通道）─────────────
# ★★ 本节是 L2 载体由 k8s 改为裸 docker 容器后的**新契约**。
#    通道与成因见上游 service/probes/{container,app}_probe.py 的文件头。
#
# 【配】Docker Engine API 的 unix socket
#   ★ 需要 collect 服务能访问：compose 已挂 /var/run/docker.sock +
#     group_add: ${CC_DOCKER_GID}
CC_DOCKER_SOCK=/var/run/docker.sock
# 【配】★ 宿主 docker 组 gid。取法：stat -c '%g' /var/run/docker.sock
#   写错的后果：容器起得来，但 Docker API 报 permission denied ⇒ 该层静默采空
CC_DOCKER_GID=988
# 【配】被测容器名过滤（如 credit-card-sim-cardsim，可 scale）
CC_APP_CONTAINER=
# 【配】宿主只读观测面的**容器内路径**（必须与 compose 挂载点逐字一致）
CC_HOST_PROC=/host/proc
CC_HOST_CGROUP=/host/sys/fs/cgroup
# 【调】宿主主 IP 的**显式覆盖**。留空 = 自动识别（读 /proc/<CC_HOST_INIT_PID>/net/fib_trie，
#   按保留网段过滤后取宿主业务地址）；自动识别拿不到时探针**留空不猜**。
#   容器网络地址（192.0.2.16/12）、回环、link-local 一律不被采用。
CC_HOST_IP=
# 【调】宿主 init 的 pid（读宿主 netns 视图用）。默认 1 = 必在宿主 netns
CC_HOST_INIT_PID=1
# 【调】数值键（★ 绝不能留空串：留空取代码默认，写空串会让 float('') 在导入期炸）
CC_DOCKER_TIMEOUT=10
CC_APP_DB_TIMEOUT=8
CC_PROBE_STATE=/tmp/cc-container-probe-state.json
# ── ★ P0-B：应用实时遥测日志 ────────────────────────────────────────────
# 【配】应用遥测日志的**宿主**目录（挂进采集容器为只读）；每 5s 一行
#   `[run] phase=MEASURED t=… tps=… p50=… p95=… p99=…` + `连接池获取偏慢 … 耗时=Xms`
CC_APP_LOG_HOST_DIR=
# 【配】容器内挂载点（须与 compose 的 volumes 目标逐字一致）
CC_APP_LOGDIR=/host/ccsim-logs
# 【调】数值键：遥测时效上限秒；超过报 notCollected(telemetry_stale)
CC_APP_TELEMETRY_MAX_AGE_S=900
# 【配】应用身份
CC_APP_CODE=CC-SIM
CC_APP_NAME=credit-card-simulator
CC_APP_TECHSTACK=Java+HikariCP+gsjdbc4
# 【配】SLO 目标（ms）。★ 允许留空 ⇒ 探针不写 sloP99Ms 属性（不猜默认值）
# 【配】SLO 目标（ms）。★ 留空 ⇒ 不写 sloP99Ms ⇒ FM-APP-ENDPOINT-SLOW 不可机判
#   标定方法：健康基线 p99 × k=2.0（本项目阈值惯例）
CC_APP_SLO_P99_MS=40.4

# ── 3.5b 上一版 k8s / HTTP 通道的残留：新探针不再读取 ─────────────────────
CC_APP_URL=
CC_APP_TIMEOUT=
APP_DELTA_SAMPLE=

# ── 3.6 L2 容器载体（上一版 k8s 通道残留）────────────────────────────────
K8S_PROM_URL=
K8S_PROM_TIMEOUT=
CC_APP_NAMESPACE=
CC_APP_POD=

# ── 3.7 日志检索（ES）与输出预算 ─────────────────────────────────────────
# 【配】Elasticsearch 地址（/tools/search_logs 用）
K8S_ES_HOST=
# 【调】日志返回的消息条数/建议条数/字节预算上限
LOG_MSG_MAX=
LOG_SUGG_MAX=
LOG_PAYLOAD_BUDGET=

# ── 3.8 delta 窗口 ───────────────────────────────────────────────────────
# 【调】delta 窗口长度（秒）。app / container 两个探针共用同一契约参数名
DELTA_WINDOW_S=300

# ── 3.9 采集模拟开关（演练用；生产务必留空）──────────────────────────────
# 【调】允许模拟采集的来源地址白名单（空 = 关闭模拟）
GDO_SIM_ALLOW_HOSTS=
# 【调】采集模拟的来源地址（模拟/回环演练用）
#   ⚠ 本变量还有第二个作用：`shared/collect/live_facts.py` 用它作为
#     `DEFAULT_PROVENANCE_URL` ⇒ 写进 CCF 的 `collector.collectUrl`
#     ⇒ 改动它会改变冻结基底的字节与快照身份。
#   ★ 因此**不要**用本变量去指定「live-facts 该去哪个采集面」——
#     那个地址请看下面第 4 节的 `CC_GATHER_URL`（R-56 起为权威取值）。
GDO_COLLECT_URL=
# 【调】模拟/回放用的目标库地址（collect_sim.py:919 读取；仅模拟演练需要）
#   ★ 键名由代码实测得出（deploy/selfcheck.py 的 S4 会断言它已登记）。
#     collect_sim 是**必需文件**（见 collect-layer.manifest.yaml 的 W1，已被实测证伪），
#     但这条键只在模拟/回放路径上用到；live 采集不需要它。
GDO_GDB_URL=


# ─────────────────────────────────────────────────────────────────────────────
# 4. 应用层服务间调用与门面参数
# ─────────────────────────────────────────────────────────────────────────────

# 【配】中性取数面（:8304）。同 compose 网络内用服务名，**不要**改成 127.0.0.1
#   —— 127.0.0.1 在容器里指向容器自己，会把"取数面"指成"不存在"
CC_LIVE_FACTS_URL=http://live-facts:8304/tools/read_facts

# 【配】live-facts 重建工作集时向采集面取数的地址（同网络内服务名）
# ★ R-56（2026-10-12）：这是 live-facts 取数面的**权威地址**
#   —— `shared/collect/live_facts.py::collect_base_url()` 依序读
#     GDO_COLLECT_URL、CC_GATHER_URL；给完整端点（…/tools/gather）也可以，会被归一化。
#   ⚠ 留空 ⇒ 回落模块内默认 `http://127.0.0.1:8187`（容器里指向 live-facts 自己，
#     取数必然失败）。**不要留空。**
CC_GATHER_URL=http://collect:8187/tools/gather

# 【调】live-facts 的**进程级**用例固定值（裁定 D48）
#   非空 ⇒ 该容器只服务这一个用例，进程内不可变；
#   切例 = docker compose up -d --force-recreate live-facts
#   留空 = live 模式（无进程级用例）
M5_CASE_ID=

# 【调】方案3 的臂。主臂 KG-T（:8303）；补充臂 KG-T-dyn 不进主判据
CC_KGT_ARM=KG-T

# 【调】各服务的内部查询超时（秒）
CC_QUERY_TIMEOUT_S=4.0
CC_GRAPHDB_INTERNAL_TIMEOUT=4.0

# 【调】ONTO 侧指标覆盖开关（留空 = 不覆盖）
CC_TOOLS_ONTO_METRICS=
CC_TOOLS_ONTO_METRICS_INTERVAL=
# 【调】工具面一次性诊断开关：把 cc_cause 的**中间值**打到 stderr
#   （读取处 `scheme2-onto/service/cc_tools_onto.py`，判定为 `bool(os.environ.get(...))`）
#   ★ 留空 = 关闭（生产默认）；写**任何非空值**都开启（含写 `0` —— 它是真值）。
CC_DEBUG_CAUSE=
# 【调】工具面清单里写死的 emittedAt（留空 = 用当前时间；固定它便于逐字复现）
CC_MANIFEST_EMITTED_AT=


# ─────────────────────────────────────────────────────────────────────────────
# 5. 契约装载用（install.sh 的 ④ 步；由脚本从上面的键推导，一般不必改）
# ─────────────────────────────────────────────────────────────────────────────

# ★ 注意：scheme1-kg/tools/load_tbox.py 读的是 CC_NEO4J_HTTP / CC_NEO4J_DB，
#   与运行期服务的 CC_NEO4J_HTTP_URL / CC_NEO4J_DATABASE **键名不同**。
#   install.sh 会按档位自动导出正确的容器内地址；仅在手工跑该脚本时才需要下面两键。
CC_NEO4J_HTTP=
CC_NEO4J_DB=

# ★ 方案3 topology_reader.py 的 Bolt 连接也支持这三个 GAUSSDB_* 别名（次要来源）
GAUSSDB_NEO4J_URI=
GAUSSDB_NEO4J_USER=
GAUSSDB_NEO4J_DB=


# ─────────────────────────────────────────────────────────────────────────────
# 6. 编排层（Dify）—— 属「外部环境依赖」，由 install.sh 体检/自动安装，不进本编排
# ─────────────────────────────────────────────────────────────────────────────

# 【配】Dify 基址（裸 IP 或域名，含协议）。留空 = 跳过 Dify 体检
DIFY_BASE_URL=
# 【密】Dify 控制台账号（register_tools / deploy_agents / check_fairness 用）
DIFY_EMAIL=
DIFY_PASSWORD=
# 【配】工作区与 App id（首次注册工具后由脚本回填）
DIFY_WORKSPACE_ID=
DIFY_APP_ID=

# 【配】自动安装 Dify 用的来源与版本（官方镜像源）
CC_DIFY_VERSION=1.17.0
CC_DIFY_GIT_URL=https://github.com/langgenius/dify.git
# 【配】源码树落地目录（默认 <仓库根>/.deps/dify）
CC_DIFY_DIR=
# 【配】Dify 对外端口。**留空 = 自动**：:80/:443 被占用时自动挑一个空闲端口
#   ★ 目标机上 :80 常被占用（本项目的联调机 192.0.2.11 上就是 GitLab 的 nginx）
#   ⇒ 留空比写死 80 更稳；deps.sh 会把最终端口写进 Dify 自己的 docker/.env
#     的 EXPOSE_NGINX_PORT / EXPOSE_NGINX_SSL_PORT。
CC_DIFY_HTTP_PORT=
CC_DIFY_HTTPS_PORT=
# 【配】本机对外的可达 IP/域名。填了才会把 CONSOLE_API_URL 等自述地址写成它；
#   留空则保留 Dify 默认（仅本机直连可用）。
CC_DIFY_PUBLIC_HOST=
# 【配】初始化管理员时用的显示名（账号/口令取上面的 DIFY_EMAIL / DIFY_PASSWORD）
CC_DIFY_ADMIN_NAME=admin
# 【调】自动安装 Dify 的内存硬闸（MB）。低于它**拒绝**安装 —— Dify 1.17.0 是 15 个
#   容器、约需 4–6 GB；192.0.2.10 内存仅余 ~5 GB，裁决 13 明令不得新增常驻容器
CC_DIFY_MIN_MEM_MB=6000
# 【配】若已有内网镜像源/已解压的源码树，填这里（脚本不做自动编排，只登记）
CC_DIFY_SOURCE=
