# ═══════════════════════════════════════════════════════════
# GaussDB 运维 Agent · 服务配置模板
# 复制为 .env 填入真实值（.env 已入 .gitignore，永不入库）
#   cp .env.example .env
# 读取顺序: service/.env → 仓库根 .env（先读到者生效，不覆盖已有环境变量）
# ═══════════════════════════════════════════════════════════

# ── 必选：GaussDB 主节点 DSN（采集/EXPLAIN/表统计 走此节点）──
# 格式: host=IP port=PORT dbname=USER_DB user=USER password=PASS
#GAUSSDB_DSN=host=10.x.x.x port=8000 dbname=postgres user=root password=CHANGE_ME

# ── 必选：节点拓扑（主备集群全部 DN；未配置则退化为 DSN 单节点）──
# 格式: host:port:node_id:node_type:alias，逗号分隔
#GAUSSDB_NODES=10.x.x.x:8000:dn_6001:DN:dn1,10.x.x.x:8000:dn_6002:DN:dn2,10.x.x.x:8000:dn_6003:DN:dn3

# ── 可选：集群标识（拓扑健康展示用）──
#GAUSSDB_CLUSTER_ID=

# ── 必选：Neo4j 本体图谱（本体驱动采集 ODC 依赖）──
# 与服务同机部署时用 127.0.0.1；跨机用容器宿主机 IP
#NEO4J_HTTP=http://127.0.0.1:7475
#NEO4J_AUTH=neo4j/CHANGE_ME

# ── 可选：服务监听（默认 0.0.0.0:8187）──
#SERVICE_HOST=0.0.0.0
#SERVICE_PORT=8187

# ── 可选：规则/预案目录（默认 <仓库根>/data/rules 与 data/runbooks）──
#RULES_DIR=/path/to/rules
#RUNBOOKS_DIR=/path/to/runbooks

# ── 以下仅 dify/ 目录的集成脚本使用 ──
# Dify 控制台（register_tools.py / apply_agent.py）
#DIFY_BASE_URL=http://10.x.x.x
#DIFY_EMAIL=admin@example.com
#DIFY_PASSWORD=CHANGE_ME
#DIFY_WORKSPACE_ID=<workspace uuid>
#DIFY_APP_ID=<Agent app uuid>
# 采集服务对 Dify 暴露的地址（tools 的 server_url，须 Dify 可达）
#OPS_BASE_URL=http://10.x.x.x:8187
